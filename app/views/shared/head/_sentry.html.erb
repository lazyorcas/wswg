<% if ENV["SENTRY_DSN"].present? %>
  <script src="https://js-de.sentry-cdn.com/b1a42fe374fdee07fb55aac8f8c71747.min.js" crossorigin="anonymous"></script>
  <script>
    window.sentryOnLoad = function () {
      Sentry.init({
        dsn: "<%= ENV["SENTRY_DSN"] %>",
        sendDefaultPii: true,
        tracesSampleRate: 0.2,
        profilesSampleRate: 1.0,
      });
    };
  </script>
  <%= Sentry.get_trace_propagation_meta.html_safe %>
<% end %>