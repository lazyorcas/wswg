<%= tag.div nil,
  data: { 
    controller: "map",
    map_target: "container",
    map_access_token_value: ENV['MAPBOX_PUBLIC_ACCESS_TOKEN'],
    map_center_value: @events.map { |event| [event.location&.longitude, event.location&.latitude] }.flatten.compact.first(2)
  },
  style: "width: 100%; height: 600px;"
%>