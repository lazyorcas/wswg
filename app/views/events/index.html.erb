<% if params[:context] == "search" %>
  <%= turbo_frame_tag "search-results" do %>
    <% if @events.any? %>
      <%= tag.section class: "flex flex-col gap-y-2 h-full pt-4", data: { map_target: "source", bottom_sheet_target: "content" } do %>
        <p class="shrink-0 text-secondary text-sm px-4">
          Here's what happening <%= wday == 6 ? "next week" : "this week" %> in <%= Current.user.city.name %>.
        </p>
        <div class="grow min-h-0">
          <%= render Event::Map::ListComponent.new(@events, 
            bookmarked_event_ids: Current.user.bookmarked_event_ids, 
            seen_event_ids: Current.user.seen_event_ids) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>