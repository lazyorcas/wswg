<% content_for :title, "Setup | Where Should We Go" %>
<% content_for :head do %>
  <meta name="robots" content="noindex" />
<% end %>
<div class="w-full h-dvh flex flex-col gap-y-8 items-center justify-center dark:bg-stone-900 px-4 md:px-0">
  <h1 class="text-3xl font-bold">Setup</h1>
  <%= form_for Current.visitor, url: current_visitor_path(return_to: referrer), method: :patch, html: { class: "w-full md:max-w-100 flex flex-col gap-y-8" } do |form| %>
    <div class="flex flex-col gap-y-1">
      <%= form.label :city_id, "City", class: "text-sm text-secondary" %>
      <%= form.select :city_id, 
          City.enabled.order(:name).map { |city| [city.name, city.id] },
          { include_blank: "Select your home city" },
          { class: "input input--accent" } %>
    </div>
    <div class="flex flex-col gap-y-2">
      <%= form.button "Let's go", class: "button button--primary" %>
      <% if request.referer.present? %>
        <%= link_to "Back", :back, class: "button button--ghost" %>
      <% else %>
        <%= link_to "Back", root_path, class: "button button--ghost" %>
      <% end %>
    </div>
  <% end %>
</div>