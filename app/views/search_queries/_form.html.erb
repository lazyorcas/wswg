<%= form_for search_query, html: { class: "flex flex-col gap-y-4" }, data: { turbo: false, controller: "search", action: "search#disable search#showStatus turbo:submit-end->search#hideStatus turbo:submit-end->search#enable" } do |form| %>
  <div class="flex flex-row gap-x-2">
    <%= form.search_field :query, placeholder: generate_search_query_placeholder, class: "input input--accent", required: true, data: { search_target: "searchInput" } %>
    <%= form.button type: :submit, class: "shrink-0 icon-button icon-button--base button--primary", data: { search_target: "submitButton" } do %>
      <i class="ph-bold ph-magnifying-glass" aria-label="Search"></i>
    <% end %>
  </div>
  <div class="hidden items-center justify-center gap-x-2 text-sm" role="status" data-search-target="status" data-nosnippet>
    <i class="ph ph-spinner animate-spin"></i>
    Searching...
  </div>
<% end %>
