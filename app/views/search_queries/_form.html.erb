<%= form_for search_query, html: { class: "flex flex-col md:flex-row gap-y-2 md:gap-x-2 md:items-center md:gap-y-0" }, data: { turbo: false } do |form| %>
  <%= form.search_field :query, placeholder: generate_search_query_placeholder, class: "input input--accent", required: true %>
  <%= form.button type: :submit, class: "button button--primary" do %>
    <i class="ph-bold ph-magnifying-glass"></i>
    Search
  <% end %>
<% end %>
