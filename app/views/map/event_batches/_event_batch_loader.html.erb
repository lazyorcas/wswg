<%= turbo_frame_tag id, loading: "lazy", class: "shrink-0", src: map_event_batch_path(event_ids: event_batch.pluck(:id), target: id), data: { action: "turbo:before-frame-render->map#delayAddNewFeatures" } do %>
  <%= render partial: "map/events/event_item_skeleton" %>
<% end %>
<% (event_batch.size - 1).times do %>
  <%= render partial: "map/events/event_item_skeleton", locals: { class_name: "#{id}_skeleton" } %>
<% end %>