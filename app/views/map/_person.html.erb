<section class="flex gap-x-1 md:gap-x-2 items-center">
  <button popovertarget="menu" class="cursor-pointer" title="Open Menu">
    <% if signed_in? %>
      <%= render "user_avatar" %>
    <% else %>
      <%= image_tag "/logo.webp", class: "size-8 md:size-10 rounded-full", alt: "Where Should We Go Logo" %>
    <% end %>
  </button>
  <div popover id="menu" class="modal p-4 w-xs max-w-full">
    <%= render "menu" %>
  </div>
</section>
