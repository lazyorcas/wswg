<%= form_for search_query, url: map_search_queries_path, html: { class: "popup !rounded-3xl fixed inset-x-4 md:static" }, data: { action: "search#blur" } do |form| %>
  <%= form.search_field :query,
    placeholder: generate_search_query_placeholder,
    class: "input !border-none truncate",
    required: true,
    data: { search_target: "searchInput", action: "search#input" }
  %>
<% end %>