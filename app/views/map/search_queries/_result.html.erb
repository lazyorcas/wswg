<%= tag.section class: "flex flex-col gap-y-2 h-full", data: { bottom_sheet_target: "content" } do %>
  <div class="shrink-0 text-sm">
    <% if events.any? %>
      <p class="px-4 pt-6 md:pt-4">
        Found <%= events.size %> events for <%= summary %>.
      </p>
    <% else %>
      <p class="px-4 py-6 md:py-4">
        Nothing found for <%= summary %>. <b>Try other keywords.</b>
      </p>
    <% end %>
  </div>
  <% if events.any? %>
    <%= tag.div class: "grow min-h-0", data: { controller: "impressions", impressions_impression_path_value: impression_path } do %>
      <%= render "map/events/events_list" do %>
        <%= render partial: "map/events/event", collection: events, cached: -> (event) { build_event_cache_key(event, is_map: true) } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>