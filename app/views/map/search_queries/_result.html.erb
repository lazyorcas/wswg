<%= tag.section class: "flex flex-col gap-y-2 h-full", data: { map_target: "source", bottom_sheet_target: "content" } do %>
  <div class="shrink-0 text-sm">
    <% if events.any? %>
      <p class="px-4 pt-6 md:pt-4">
        Found <%= events.size %> events for <%= summary %>.
      </p>
    <% else %>
      <p class="px-4 py-6 md:py-4">
        Nothing found for <%= summary %>. <b>Try other keywords.</b>
      </p>
    <% end %>
  </div>
  <% if events.any? %>
    <div class="grow min-h-0">
      <%= render Event::Map::ListComponent.new(events, 
        bookmarked_event_ids: searcher&.is_a?(User) ? searcher.bookmarked_event_ids : [], 
        seen_event_ids: searcher&.seen_event_ids || []) %>
    </div>
  <% end %>
<% end %>