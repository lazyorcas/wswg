<%= tag.section class: "flex flex-col gap-y-2 h-full", data: { map_target: "source", bottom_sheet_target: "content" } do %>
  <div class="shrink-0 text-secondary text-sm">
    <% if events.any? %>
      <p class="px-4 pt-4">
        Found <%= events.size %> events in <%= pluralize(took_in_seconds, "second") %>.
      </p>
    <% else %>
      <p class="p-4">
        Nothing found. Try other keywords.
      </p>
    <% end %>
  </div>
  <% if events.any? %>
    <div class="grow min-h-0">
      <%= render Event::Map::ListComponent.new(events, 
        bookmarked_event_ids: user.bookmarked_event_ids, 
        seen_event_ids: user.seen_event_ids) %>
    </div>
  <% end %>
<% end %>