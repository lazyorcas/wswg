<%= tag.section class: "flex flex-col h-full gap-y-2", data: { bottom_sheet_target: "content", collapsed: true } do %>
  <header class="shrink-0 pt-6 md:pt-4 px-4 flex gap-2 justify-between">
    <div>
      <h1 class="font-bold">
        <% if current_page?(map_path) %>
          Upcoming nearby events
        <% else %>
          Upcoming events in <%= city.name %>
        <% end %>
      </h1>
      <% if events.any? %>
        <p class="text-sm text-secondary">
          Search for more relevant events.
        </p>
      <% end %>
    </div>
    <% if events.any? %>
      <div class="shrink-0">
        <%= render "current_person/settings/preferences/sort_by_popover_button" %>
      </div>
    <% end %>
  </header>
  <%= tag.div class: "grow min-h-0", data: { controller: "impressions", impressions_impression_path_value: impression_path } do %>
    <% if events.any? %>
      <%= render "map/events/events_list" do %>
        <% if sort_by_interests? %>
          <%= render partial: "map/events/event", collection: events, cached: -> (event) { build_event_cache_key(event, is_map: true) } %>
          <%= turbo_frame_tag "new_event_batch_loader", loading: "lazy", src: @recommendation_batch_path, class: "shrink-0" do %>
            <%= render partial: "map/events/event_item_skeleton" %>
          <% end %>
          <% (EventBatch::BATCH_SIZE - 1).times do %>
            <%= render partial: "map/events/event_item_skeleton" %>
          <% end %>
        <% elsif event_batches.present? %>
          <% event_batches.each_with_index do |event_batch, index| %>
            <% if index.zero? %>
              <%= render partial: "map/events/event", collection: event_batch, cached: -> (event) { build_event_cache_key(event, is_map: true) } %>
            <% else %>
              <%= render "map/event_batches/event_batch_loader", event_batch: event_batch, id: "event_batch_#{index}_loader" %>
            <% end %>
          <% end %>
        <% else %>
          <%= render partial: "map/events/event", collection: events, cached: -> (event) { build_event_cache_key(event, is_map: true) } %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-sm text-secondary px-4 pb-6 md:pb-4">
        No events found.
      </p>
    <% end %>
  <% end %>
<% end %>