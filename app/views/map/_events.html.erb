<%= tag.section class: "flex flex-col h-full", data: { map_target: "source", bottom_sheet_target: "content", collapsed: true } do %>
  <header class="shrink-0 pt-6 md:pt-4 px-4 flex gap-2 justify-between">
    <h1 class="font-bold">
      <% if current_page?(map_path) %>
        Upcoming events in your city
      <% else %>
        Upcoming events in <%= city.name %>
      <% end %>
    </h1>
    <div class="shrink-0 -mt-2 -mr-2">
      <%= render "current_person/settings/preferences/sort_by_popover_button" %>
    </div>
  </header>
  <div class="grow min-h-0">
    <% if events.any? %>
      <%= render Event::Map::ListComponent.new(events, 
        bookmarked_event_ids: Current.person.bookmarked_event_ids, 
        seen_event_ids: Current.person.seen_event_ids) %>
    <% else %>
      <p class="text-sm text-secondary px-4 pb-6 md:pb-4">
        No events found.
      </p>
    <% end %>
  </div>
<% end %>