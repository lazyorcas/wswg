<nav class="flex flex-col">
  <div class="flex flex-col">
    <%= link_to "Home", root_path, class: "button button--ghost" %>
    <%= link_to "Pricing", pricing_path, class: "button button--ghost" %>
  </div>
  <hr class="border-primary my-4">
  <div class="flex flex-col gap-y-4">
    <% unless signed_in? %>
      <div class="flex items-center gap-x-2">
        <%= link_to "Login", login_path, class: "flex-1 button button--secondary" %>
        <%= link_to "Sign up", new_user_path("user[city_id]" => @city&.id, source: "Sign up button in navbar"), class: "flex-1 button button--primary" %>
      </div>
    <% end %>
    <p class="text-sm text-center">
      Or contact us via <%= link_to "email", "mailto:#{ENV["GMAIL_SENDER_EMAIL"]}", class: "link" %> or <%= link_to "Linkedin", "https://www.linkedin.com/company/where-should-we-go/", class: "link" %>.
    </p>
  </div>
</nav>