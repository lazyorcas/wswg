<% links = [
  ["Search", map_search_queries_path, current_page?(map_path)], 
  ["Bookmarks", map_bookmarked_events_path, current_page?(map_bookmarked_events_path)]
] %>
<%= tag.nav class: "shrink-0 flex gap-x-1 md:gap-x-2", data: { controller: "home-nav" } do %>
  <% links.each do |link| %>
    <%= link_to link[0], link[1], 
      class: class_names("map-tab-button", link[2] ? "map-tab-button--active" : "map-tab-button--inactive"), 
      data: { 
        turbo_frame: "content",
        home_nav_target: "link"
      } %>
  <% end %>
<% end %>