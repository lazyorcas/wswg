<% content_for :head do %>
  <%= javascript_include_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.js" %>
  <%= stylesheet_link_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.css" %>
<% end %>
<% content_for :title, build_meta_title(current_page?(map_path) ? "Events Map" : "#{@city.name} Events Map") %>
<% content_for :description, current_page?(map_path) ? "Discover nearby events, meetups, and concerts from multiple sources on the city map." : "Discover events, meetups, and concerts in #{@city.name} from multiple sources on the city map." %>
<%= tag.main class: "w-full h-dvh max-h-dvh flex", 
  data: { 
    controller: "map",
    map_access_token_value: ENV['MAPBOX_PUBLIC_ACCESS_TOKEN'],
    map_center_coordinates_value: get_mapbox_coordinates(@city.coordinates),
    map_is_mobile_value: browser.device.mobile?
  } do %>
  <div class="size-full" data-map-target="container"></div>
  <section class="absolute py-4 md:py-8 left-4 md:left-8 flex max-h-full md:gap-x-2">
    <div class="flex flex-col gap-y-2 max-h-full">
      <%= render "nav" %>
      <%= turbo_frame_tag "content", class: "grow min-h-0 map-content" do %>
        <%= tag.section class: "flex flex-col gap-y-2 h-full", data: { controller: "search" } do %>
          <div class="shrink-0">
            <%= render "map/search_queries/form", search_query: @search_query.dup %>
          </div>
          <%= tag.section id: "search-results", class: "grow md:min-h-0 popup popup--bottom-sheet bottom-sheet-transition", data: { controller: "bottom-sheet", bottom_sheet_target: "bottomSheet", search_target: "results" } do %>
            <%= render "events", city: @city, events: @events, search_query: @search_query %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% if browser.device.mobile? %>
      <%= turbo_frame_tag "event-bottom-sheet", 
      class: "popup popup--bottom-sheet bottom-sheet-transition z-[11]",
      data: { controller: "bottom-sheet", bottom_sheet_target: "bottomSheet" }
    %>
    <% end %>
  </section>
  <div class="absolute py-4 md:py-8 right-4 md:right-8">
    <%= render partial: "person" %>
  </div>
<% end %>