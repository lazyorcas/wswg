<section class="flex gap-x-1 md:gap-x-2 items-center">
  <%= link_to user_top_up_credits_path, class: "flex gap-x-2 items-center bg-white dark:bg-stone-900 rounded-full py-1 px-2 border border-primary", title: "Top up" do %>
    <i class="ph ph-coin"></i>
    <span class="text-sm"><%= Current.user.credits %></span>
  <% end %>
  <button popovertarget="menu" class="cursor-pointer" title="Open Menu">
    <%= render "user_avatar" %>
  </button>
  <div popover id="menu" class="modal p-4 w-xs max-w-full">
    <h2 class="text-lg font-bold mb-2">Menu</h2>
    <ol class="flex flex-col gap-y-1">
      <li class="flex items-center gap-x-2">
        <i class="ph ph-house size-4"></i>
        <%= link_to "Go to homepage", root_path, class: "text-sm link" %>
      </li>
      <li class="flex items-center gap-x-2">
        <i class="ph ph-coins size-4"></i>
        <%= link_to "View pricing", pricing_path, class: "text-sm link" %>
      </li>
      <li class="flex items-center gap-x-2 text-sm">
        <i class="ph ph-envelope size-4"></i>
        <p>
          Contact us via <%= link_to "email", "mailto:#{ENV["GMAIL_SENDER_EMAIL"]}", class: "link" %> or <%= link_to "Linkedin", "https://www.linkedin.com/company/where-should-we-go/", class: "link" %>
        </p>
      </li>
    </ol>
  </div>
</section>