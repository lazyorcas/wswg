<% if search_query.ongoing? %>
  <%= render "map/search_queries/status", search_query: search_query %>
<% else %>
  <%= tag.section class: "flex flex-col h-full", data: { bottom_sheet_target: "content", collapsed: true } do %>
    <header class="shrink-0 pt-6 md:pt-4 px-4 flex gap-2 justify-between">
      <div>
        <h1 class="font-bold">
          Search Results
        </h1>
        <% if events.any? %>
          <p class="text-sm text-secondary">
            <% if events.any? %>
              Found <%= events.size %> events for <%= search_query.summary %>.
            <% else %>
              Nothing found for <%= search_query.summary %>. <b>Try other keywords.</b>
            <% end %>
          </p>
        <% end %>
      </div>
    </header>
    <%= tag.div class: "grow min-h-0", data: { controller: "impressions", impressions_impression_path_value: impression_path } do %>
      <% if events.any? %>
        <%= render "map/events/events_list" do %>
          <%= render partial: "map/events/event", collection: events, cached: -> (event) { build_event_cache_key(event, is_map: true) } %>
        <% end %>
      <% else %>
        <p class="text-sm text-secondary px-4 pb-6 md:pb-4">
          No events found.
        </p>
      <% end %>
    <% end %>
  <% end %>
<% end %>