<% content_for :title, "Analytics | Where Should We Go" %>
<main class="dark:bg-stone-900 min-h-dvh p-4 md:p-8">
  <header class="flex flex-col md:flex-row md:justify-between gap-y-2 md:gap-y-0 mb-8">
    <h1 class="text-3xl font-bold">Analytics</h1>
    <%= form_with method: :get, html: { class: "flex flex-wrap gap-2" } do |form| %>
      <%= form.date_field :start_date, value: @start_date, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.date_field :end_date, value: @end_date, class: "whitespace-nowrap shrink-0 input input--accent  w-fit" %>
      <%= form.select :time_interval, options_for_select([["Day", "day"], ["Week", "week"]], @time_interval), {}, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.submit "Filter", class: "button button--secondary" %>
    <% end %>
  </header>
  <div class="flex flex-col gap-y-8">
    <%= render "charts", title: "Web Traffic" do %>
      <%= render "chart", title: "Ahoy Visits" do %>
        <%= line_chart @visits %>
      <% end %>
      <%= render "chart", title: "Ahoy Visits by Device" do %>
        <%= line_chart @visits_by_device %>
      <% end %>
      <%= render "chart", title: "Ahoy Events - Sign Up Page" do %>
        <%= line_chart @sign_up_page_events %>
      <% end %>
      <%= render "chart", title: "Ahoy Events - Pricing Page" do %>
        <%= line_chart @pricing_page_events %>
      <% end %>
      <%= render "chart", title: "Ahoy Events - City Events Page" do %>
        <%= line_chart @city_events_page_events %>
      <% end %>
      <%= render "chart", title: "Ahoy Events - Homepage" do %>
        <%= line_chart @homepage_events %>
      <% end %>
      <%= render "chart", title: "Ahoy Visits by Referring Domain" do %>
        <%= column_chart @visits_by_referring_domain, stacked: true %>
      <% end %>
    <% end %>
    <%= render "charts", title: "SEO - Popularity of City Events Pages" do %>
      <%= render "chart", title: "By City" do %>
        <%= line_chart @city_views %>
      <% end %>
      <%= render "chart", title: "By Time Period" do %>
        <%= line_chart @time_period_views %>
      <% end %>
      <%= render "chart", title: "By Day of Week" do %>
        <%= line_chart @wday_views %>
      <% end %>
      <%= render "chart", title: "By City & Time Period" do %>
        <%= line_chart @city_time_period_views, legend: false %>
      <% end %>
    <% end %>
    <%= render "charts", title: "SEO - City Events Pages" do %>
      <%= render "chart", title: "Non-user Seens" do %>
        <%= line_chart @seens %>
      <% end %>
    <% end %>
    <%= render "charts", title: "SEO - City Events Page -> Sign Up Page" do %>
      <%= render "chart", title: "Which queries upon arriving at the sign up page?" do %>
        <%= pie_chart @sign_up_page_queries %>
      <% end %>
      <%= render "chart", title: "Which cities upon arriving at the sign up page?" do %>
        <%= line_chart @sign_up_page_cities %>
      <% end %>
      <%= render "chart", title: "How many bookmarks led to sign ups?" do %>
        <%= line_chart @sign_up_page_bookmarks %>
      <% end %>
    <% end %>
    <%= render "charts", title: "Product" do %>
      <%= render "chart", title: "User Growth" do %>
        <%= line_chart @aggregated_users, curve: false %>
      <% end %>
      <%= render "chart", title: "Sign Ins" do %>
        <%= line_chart @sign_ins %>
      <% end %>
      <%= render "chart", title: "Search Queries created" do %>
        <%= line_chart @search_queries %>
      <% end %>
      <%= render "chart", title: "Bookmarks created" do %>
        <%= line_chart @bookmarks %>
      <% end %>
      <%= render "chart", title: "Events created by city" do %>
        <%= area_chart @events_by_city, stacked: true %>
      <% end %>
      <%= render "chart", title: "Events created by source" do %>
        <%= area_chart @events_by_source, stacked: true %>
      <% end %>
    <% end %>
  </div>
</main>