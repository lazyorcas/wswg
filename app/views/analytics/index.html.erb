<% content_for :title, "Analytics | Where Should We Go" %>
<main class="dark:bg-stone-900 min-h-dvh p-4 md:p-8">
  <header class="flex flex-col md:flex-row md:justify-between gap-y-2 md:gap-y-0 mb-8">
    <h1 class="text-3xl font-bold">Analytics</h1>
    <%= form_with method: :get, html: { class: "flex flex-wrap gap-2" } do |form| %>
      <%= form.date_field :start_date, value: @start_date, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.date_field :end_date, value: @end_date, class: "whitespace-nowrap shrink-0 input input--accent  w-fit" %>
      <%= form.select :time_interval, options_for_select([["Day", "day"], ["Week", "week"]], @time_interval), {}, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.submit "Filter", class: "button button--secondary" %>
    <% end %>
  </header>
  <div class="flex flex-col gap-y-8">
    <%= render "charts", title: "Web Traffic" do %>
      <%= render "chart", title: "Visitors" do %>
        <%= column_chart @visitors, stacked: true %>
      <% end %>
      <%= render "chart", title: "Unbounced Visitors" do %>
        <%= column_chart @unbounced_visitors, stacked: true %>
      <% end %>
      <%= render "chart", title: "Bounces by City" do %>
        <%= column_chart @bounces_by_city, stacked: true %>
      <% end %>
      <%= render "chart", title: "Bounces by Duration" do %>
        <%= column_chart @bounces_by_duration, stacked: true %>
      <% end %>
      <%= render "chart", title: "Bounces by Referrer Host" do %>
        <%= column_chart @bounces_by_referrer_host, stacked: true %>
      <% end %>
      <%= render "chart", title: "Popular City Events pages" do %>
        <%= column_chart @city_events_page_events, stacked: true %>
      <% end %>
      <%= render "chart", title: "Popular Nearby Events' Cities" do %>
        <%= column_chart @nearby_events_page_views, stacked: true %>
      <% end %>
      <%= render "chart", title: "Viewed pricing page" do %>
        <%= column_chart @pricing_page_events %>
      <% end %>
    <% end %>
    <%= render "charts", title: "Usage" do %>
      <%= render "chart", title: "Searched" do %>
        <%= column_chart @searches %>
      <% end %>
      <%= render "chart", title: "Search queries" do %>
        <table class="min-w-full">
          <tbody class="divide-y divide-primary overflow-y-scroll flex flex-col"  style="max-height: 300px;">
            <% @search_queries.each do |time, query| %>
              <tr>
                <td class="py-2 px-4 text-sm text-secondary min-w-32 w-32 max-w-32">
                  <%= time_ago_in_words(time) %> ago
                </td>
                <td class="py-2 px-4 text-sm text-primary">
                  <%= query %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <%= render "chart", title: "Viewed event" do %>
        <%= column_chart @viewed_event_events, stacked: true %>
      <% end %>
      <%= render "chart", title: "Viewed map" do %>
        <%= column_chart @map_page_events %>
      <% end %>
      <%= render "chart", title: "Retention" do %>
        <%= line_chart @visitor_retention, suffix: "%", curve: false %>
      <% end %>
      <%= render "chart", title: "Popularity by Day of Week" do %>
        <%= line_chart @wday_views %>
      <% end %>
    <% end %>
    <%= render "charts", title: "Scraped Events" do %>
      <%= render "chart", title: "City Scores" do %>
        <%= bar_chart @city_scores, height: "740px" %>
      <% end %>
      <div class="flex flex-col gap-y-8">
        <%= render "chart", title: "Events created by Source" do %>
          <%= column_chart @events_created_by_source, stacked: true %>
        <% end %>
        <%= render "chart", title: "Events created by City" do %>
          <%= column_chart @events_created_by_city, stacked: true %>
        <% end %>
      </div>
    <% end %>
  </div>
</main>