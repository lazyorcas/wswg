<% content_for :title, "Analytics | Where Should We Go" %>
<div class="dark:bg-stone-900 min-h-dvh">
  <header class="flex flex-col md:flex-row md:justify-between gap-y-2 md:gap-y-0 p-4 md:p-8 sticky top-0 border-b border-primary z-10 bg-white dark:bg-stone-900">
    <h1 class="text-3xl font-bold">Analytics</h1>
    <%= form_with method: :get, html: { class: "no-scrollbar flex items-center gap-x-2 overflow-x-scroll" } do |form| %>
      <%= form.date_field :start_date, value: @start_date, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.date_field :end_date, value: @end_date, class: "whitespace-nowrap shrink-0 input input--accent  w-fit" %>
      <%= form.select :time_interval, options_for_select([["Day", "day"], ["Week", "week"], ["Month", "month"]], @time_interval), {}, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.submit "Filter", class: "button button--secondary" %>
    <% end %>
  </header>
  <main class="flex flex-col gap-y-8 py-4 md:py-8 px-4 md:px-8">
    <%= render "charts", title: "Market" do %>
      <%= render "chart", title: "Which day of the week do people look for events?" do %>
        <%= area_chart @wday_views, stacked: true %>
      <% end %>
      <%= render "chart", title: "What do people search for?" do %>
        <table class="min-w-full">
          <tbody class="divide-y divide-primary overflow-y-scroll flex flex-col"  style="max-height: 300px;">
            <% @search_queries.each do |time, query| %>
              <tr>
                <td class="py-2 px-4 text-sm text-secondary min-w-32 w-32 max-w-32">
                  <%= time_ago_in_words(time) %> ago
                </td>
                <td class="py-2 px-4 text-sm text-primary">
                  <%= query %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>
    <section class="flex flex-col gap-y-4">
      <h2 class="text-2xl font-semibold">Journey</h2>
      <%= render "chart", title: "What do people do during their visit?" do %>
        <table class="min-w-full">
          <tbody class="divide-y divide-primary overflow-y-scroll flex flex-col max-h-64 md:max-h-128">
            <% @journeys.each do |journey| %>
              <tr class="flex flex-col md:flex-row gap-y-2 md:gap-y-0 md:gap-x-4 text-sm py-2">
                <td class="md:flex-2 text-secondary">
                  <%= time_ago_in_words(journey[:started_at]) %> ago
                </td>
                <td class="md:flex-2 text-secondary">
                  <%= journey[:duration] ? distance_of_time_in_words(journey[:duration]) : "n/a" %>
                </td>
                <td class="md:flex-2 text-primary" style="word-break: break-word;">
                  <%= journey[:origin] %>
                  <% if journey[:prior_visits_count] > 0 %>
                    (returning - <%= journey[:prior_visits_count] %>)
                  <% end %>
                </td>
                <td class="md:flex-9 text-primary">
                  <%= journey[:events] %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
    <%= render "charts", title: "Acquisition" do %>
      <%= render "chart", title: "Visitors" do %>
        <%= column_chart @visitors, stacked: true %>
      <% end %>
      <%= render "chart", title: "Viewed homepage" do %>
        <%= column_chart @homepage_views, stacked: true %>
      <% end %>
      <%= render "chart", title: "Viewed events pages" do %>
        <%= column_chart @events_page_views, stacked: true %>
      <% end %>
      <%= render "chart", title: "Viewed pricing page" do %>
        <%= column_chart @pricing_page_events %>
      <% end %>
    <% end %>
    <%= render "charts", title: "Activation" do %>
      <%= render "chart", title: "Unbounced visitors" do %>
        <%= column_chart @unbounced_visitors %>
      <% end %>
      <%= render "chart", title: "Visitor actions" do %>
        <%= column_chart @visitor_actions, stacked: true %>
      <% end %>
      <%= render "chart", title: "Time taken until an event is viewed" do %>
        <%= pie_chart @time_taken_until_first_viewed_event %>
      <% end %>
      <%= render "chart", title: "Viewed event by source" do %>
        <%= column_chart @viewed_event_events_by_source, stacked: true %>
      <% end %>
      <%= render "chart", title: "Bounces by Landing Page" do %>
        <%= column_chart @bounces_by_landing_page, stacked: true %>
      <% end %>
      <%= render "chart", title: "Bounces by Duration" do %>
        <%= column_chart @bounces_by_duration, stacked: true %>
      <% end %>
    <% end %>
    <%= render "charts", title: "Retention" do %>
      <%= render "chart", title: "Retention by referrer" do %>
        <%= line_chart @retention_by_referrer_host, suffix: "%", curve: false %>
      <% end %>
    <% end %>
    <%= render "charts", title: "System" do %>
      <%= render "chart", title: "City Scores" do %>
        <%= bar_chart @city_scores, height: "740px" %>
      <% end %>
      <div class="flex flex-col gap-y-8">
        <%= render "chart", title: "Events created by Source" do %>
          <%= column_chart @events_created_by_source, stacked: true %>
        <% end %>
        <%= render "chart", title: "Events created by City" do %>
          <%= column_chart @events_created_by_city, stacked: true %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>