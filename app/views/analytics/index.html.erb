<% content_for :title, "Analytics | Where Should We Go" %>
<main class="dark:bg-stone-900 min-h-dvh p-4 md:p-8">
  <header class="flex flex-col md:flex-row md:justify-between gap-y-2 md:gap-y-0 mb-8">
    <h1 class="text-3xl font-bold">Analytics</h1>
    <%= form_with method: :get, html: { class: "flex flex-wrap gap-2" } do |form| %>
      <%= form.date_field :start_date, value: @start_date, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.date_field :end_date, value: @end_date, class: "whitespace-nowrap shrink-0 input input--accent  w-fit" %>
      <%= form.select :time_interval, options_for_select([["Day", "day"], ["Week", "week"]], @time_interval), {}, class: "whitespace-nowrap shrink-0 input input--accent w-fit" %>
      <%= form.submit "Filter", class: "button button--secondary" %>
    <% end %>
  </header>
  <div class="flex flex-col gap-y-8">
    <%= render "charts", title: "Web Traffic" do %>
      <%= render "chart", title: "Ahoy Visits" do %>
        <%= line_chart @visits %>
      <% end %>
      <%= render "chart", title: "Ahoy Visitors" do %>
        <%= line_chart @visitors %>
      <% end %>
      <%= render "chart", title: "Ahoy Events - Pricing Page" do %>
        <%= line_chart @pricing_page_events %>
      <% end %>
      <%= render "chart", title: "Ahoy Events - City Events Page" do %>
        <%= line_chart @city_events_page_events %>
      <% end %>
      <%= render "chart", title: "Ahoy Events - Homepage" do %>
        <%= line_chart @homepage_events %>
      <% end %>
      <%= render "chart", title: "Ahoy Visitor Retention" do %>
        <%= line_chart @visitor_retention, suffix: "%", xtitle: "nth #{@time_interval}" %>
      <% end %>
      <%= render "chart", title: "Days Between First and Second Visit" do %>
        <%= column_chart @days_between_first_and_second_visits %>
      <% end %>
      <%= render "chart", title: "Days Between First and Last Visit" do %>
        <%= column_chart @days_between_first_and_last_visits %>
      <% end %>
      <%= render "chart", title: "Ahoy Visits by Device" do %>
        <%= pie_chart @visits_by_device, legend: "right" %>
      <% end %>
      <%= render "chart", title: "Ahoy Visits by Browser" do %>
        <%= pie_chart @visits_by_browser, legend: "right" %>
      <% end %>
      <%= render "chart", title: "Ahoy Visits by Referring Domain" do %>
        <%= pie_chart @visits_by_referring_domain, legend: "right" %>
      <% end %>
    <% end %>
    <%= render "charts", title: "SEO - City Events Pages" do %>
      <%= render "chart", title: "Popularity by Day of Week" do %>
        <%= line_chart @wday_views %>
      <% end %>
      <%= render "chart", title: "Visits by Hour of Day" do %>
        <%= pie_chart @hour_views, legend: "right", colors: [
          "#1e1a4d", # 0:00
          "#1e1a4d", # 1:00
          "#1e1a4d", # 2:00
          "#1e1a4d", # 3:00
          "#1e1a4d", # 4:00
          "#1447e6", # 5:00
          "#1447e6", # 6:00
          "#1447e6", # 7:00
          "#51a2ff", # 8:00
          "#51a2ff", # 9:00
          "#51a2ff", # 10:00
          "#fcc800", # 11:00
          "#fcc800", # 12:00
          "#fcc800", # 13:00
          "#fd9a00", # 14:00
          "#fd9a00", # 15:00
          "#fd9a00", # 16:00
          "#fd9a00", # 17:00
          "#372aac", # 18:00
          "#372aac", # 19:00
          "#372aac", # 20:00
          "#312c85", # 21:00
          "#312c85", # 22:00
          "#312c85"  # 23:00
        ] %>
      <% end %>
      <%= render "chart", title: "Popularity by City & Time Period (Top 20)" do %>
        <%= pie_chart @city_time_period_views, legend: "right" %>
      <% end %>
      <%= render "chart", title: "Nearby Events Page Views" do %>
        <%= line_chart @nearby_events_page_views %>
      <% end %>
      <%= render "chart", title: "Nearby Events Page Views by City" do %>
        <%= pie_chart @nearby_events_city_views, legend: "right" %>
      <% end %>
      <%= render "chart", title: "Viewed Event Descriptions" do %>
        <%= line_chart @viewed_event_descriptions %>
      <% end %>
      <%= render "chart", title: "Non-user Seens" do %>
        <%= line_chart @seens %>
      <% end %>
      <%= render "chart", title: "Non-user Seens by City" do %>
        <%= pie_chart @seens_by_city, legend: "right" %>
      <% end %>
    <% end %>
    <%= render "charts", title: "SEO - Map & Search" do %>
      <%= render "chart", title: "Map page visits by city" do %>
        <%= pie_chart @map_page_visits_by_city %>
      <% end %>
      <%= render "chart", title: "Search queries" do %>
        <table class="min-w-full">
          <tbody class="bg-white divide-y divide-primary overflow-y-scroll flex flex-col"  style="max-height: 300px;">
            <% @map_page_queries.each do |time, query| %>
              <tr>
                <td class="py-2 px-4 whitespace-nowrap text-sm text-secondary min-w-32 w-32 max-w-32 text-wrap">
                  <%= time_ago_in_words(time) %> ago
                </td>
                <td class="py-2 px-4 text-sm text-primary">
                  <%= query %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <%= render "chart", title: "Which sources led to sign ups?" do %>
        <%= pie_chart @sign_up_page_sources %>
      <% end %>
    <% end %>
    <%= render "charts", title: "Product" do %>
      <%= render "chart", title: "User Growth" do %>
        <%= line_chart @aggregated_users, curve: false %>
      <% end %>
      <%= render "chart", title: "Sign Ins" do %>
        <%= line_chart @sign_ins %>
      <% end %>
      <%= render "chart", title: "Visited map page" do %>
        <%= line_chart @map_page_events %>
      <% end %>
      <%= render "chart", title: "Search Queries created" do %>
        <%= line_chart @search_queries %>
      <% end %>
      <%= render "chart", title: "Bookmarks created" do %>
        <%= line_chart @bookmarks %>
      <% end %>
    <% end %>
    <%= render "charts", title: "Scraped Events" do %>
      <%= render "chart", title: "Events created by city" do %>
        <%= column_chart @events_by_city, stacked: true, legend: false %>
      <% end %>
      <%= render "chart", title: "Events created by source" do %>
        <%= area_chart @events_by_source, stacked: true %>
      <% end %>
    <% end %>
    <%= render "charts", title: "City Popularity" do %>
      <%= render "chart", title: "Active User Scores" do %>
        <%= bar_chart @city_active_user_scores, height: "500px" %>
      <% end %>
      <%= render "chart", title: "Visitor Scores" do %>
        <%= bar_chart @city_visitor_scores, height: "500px" %>
      <% end %>
    <% end %>
  </div>
</main>