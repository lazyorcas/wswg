<% content_for :title, "Login | Where Should We Go" %>
<% content_for :description, "Login to Where Should We Go to discover interesting local events, meetups, and concerts from multiple platforms faster." %>
<div class="grow flex flex-col justify-center items-center gap-y-8 w-full">
  <h1 class="text-3xl font-bold">Login</h1>
  <div class="w-full md:max-w-100 flex flex-col gap-y-8 md:gap-y-16">
    <%= render "passwordless/sessions/form", session: @passwordless_session %>
    <div class="flex items-center gap-x-2">
      <hr class="grow border-primary" />
      <span class="shrink-0 text-sm text-secondary self-center">Or</span>
      <hr class="grow border-primary" />
    </div>
    <div class="flex flex-col gap-y-2">
      <%= render "omniauth_sessions/form" %>
      <%= link_to "Sign up if you haven't", new_user_path(source: "Sign up button in login page"), class: "button button--ghost" %>
    </div>
  </div>
</div>