<% content_for :title, "Top up needed | Where Should We Go" %>
<div class="w-full h-dvh flex flex-col gap-y-8 items-center justify-center dark:bg-stone-900 px-4 md:px-0">
  <h1 class="text-3xl font-bold text-center">No credits left for this month.</h1>
  <div class="w-full md:max-w-100 flex flex-col gap-y-2">
    <%= link_to signed_in? ? current_user_top_up_credits_path : new_user_path(source: "Top up needed page"), class: "button button--primary w-full" do %>
      <% if signed_in? %>
        <i class="ph-fill ph-coin"></i>
        Top up
      <% else %>
        Claim more free credits
      <% end %>
    <% end %>
    <%= link_to "View pricing", pricing_path, class: "button button--secondary", target: "_blank" %>
    <% if request.referer.present? %>
      <%= link_to "Back", :back, class: "button button--ghost" %>
    <% else %>
      <%= link_to "Back", root_path, class: "button button--ghost" %>
    <% end %>
  </div>
</div>
