<table class="table-fixed">
  <thead class="bg-accent">
    <tr>
      <% business_events_table_headers.each do |header| %>
        <%= tag.th style: "width: #{header[:width]}%;" do %>
          <span class="flex items-center gap-x-2">
            <%= tag.i class: class_names("ph", header[:icon]) %>
            <%= tag.span header[:label] %>
            <% if header[:filter_id].present? %>
              <span class="ml-auto shrink-0">
                <%= render "businesses/#{header[:filter_id]}_filter_popover_button" %>
              </span>
            <% end %>
          </span>
        <% end %>
      <% end %>
    </tr>
    <tr class="h-[1px] bg-stone-300 dark:bg-stone-700">
      <td colspan="6" class="p-0"></td>
    </tr>
  </thead>
  <tbody>
    <% events.each do |event| %>
      <%= render Business::EventTableComponent.new(event) %>
    <% end %>
  </tbody>
</table>