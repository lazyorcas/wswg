<%= content_for :title, "#{@title} - #{Current.business.name}" %>
<% if event_query_params.present? %>
  <%= content_for :toolbar do %>
    <%= link_to business_events_path(params: {}), class: "button button--ghost" do %>
      <%= tag.i class: "ph ph-x" %>
      <span>Clear filters</span>
    <% end %>
  <% end %>
<% end %>
<%= render "events", events: @events %>