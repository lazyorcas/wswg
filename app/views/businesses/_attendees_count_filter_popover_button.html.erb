<%= tag.button popovertarget: "attendees_count_filter_popover", class: class_names("icon-button icon-button--xs", filtering_by_attendees_count? ? "button--active" : "button--ghost"), title: "Filter by Attendees" do %>
  <%= tag.i class: class_names("ph-funnel", filtering_by_attendees_count? ? "ph-fill" : "ph") %>
<% end %>
<div popover id="attendees_count_filter_popover" class="modal p-4 w-xs max-w-full">
  <div class="flex flex-col">
    <p class="mb-4 text-lg font-bold text-primary">Attendees</p>
    <%= form_with url: business_events_path, method: :get, html: { class: "flex flex-col gap-y-4" } do |form| %>
      <% event_query_params.each do |key, value| %>
        <%= form.hidden_field key, value: value %>
      <% end %>
      <div class="flex items-center gap-x-2">
        <%= form.number_field :min_attendees_count, { value: event_query_params[:min_attendees_count], class: "flex-1 input input--accent", min: 0, placeholder: "Minimum" } %>
        -
        <%= form.number_field :max_attendees_count, { value: event_query_params[:max_attendees_count], class: "flex-1 input input--accent", min: 0, placeholder: "Maximum" } %>
      </div>
      <%= form.submit "Filter", class: "button button--primary" %>
    <% end %>
    <% if filtering_by_attendees_count? %>
      <%= form_with url: business_events_path, method: :get, class: "mt-2" do |form| %>
        <% event_query_params.except(:min_attendees_count, :max_attendees_count).each do |key, value| %>
          <%= form.hidden_field key, value: value %>
        <% end %>
        <%= form.submit "Clear filter", class: "w-full button button--ghost" %>
      <% end %>
    <% end %>
  </div>
</div>