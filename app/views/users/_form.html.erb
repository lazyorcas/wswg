<%= form_for user, html: { class: "flex flex-col gap-y-8" } do |form|  %>
  <div class="flex flex-col gap-y-4">
    <div class="flex flex-col gap-y-1">
      <%= form.label :email, "Email", class: "text-sm text-secondary" %>
      <%= form.email_field :email, required: true, class: "input", placeholder: "Enter your email" %>
    </div>
    <div class="flex flex-col gap-y-1">
      <%= form.label :city_id, "City", class: "text-sm text-secondary" %>
      <%= form.select :city_id, 
          City.enabled.order(:name).map { |city| [city.name, city.id] },
          { include_blank: "Select your home city", required: true, selected: user.city_id },
          { class: "input" } %>
    </div>
    <%= form.fields_for :bookmarks do |bookmark_form| %>
      <%= bookmark_form.hidden_field :event_id %>
    <% end %>
    <%= form.fields_for :search_queries do |search_query_form| %>
      <%= search_query_form.hidden_field :query %>
    <% end %>
    <div class="flex items-start gap-x-2">
      <%= form.check_box :terms_of_service_and_privacy_policy_accepted, required: true, class: "mt-1" %>
      <%= form.label :terms_of_service_and_privacy_policy_accepted, class: "text-sm text-secondary" do %>
        I agree to the <%= link_to "Terms of Service", "/terms", class: "font-bold hover:underline", target: "_blank" %> and 
        <%= link_to "Privacy Policy", "/privacy", class: "font-bold hover:underline", target: "_blank" %>
      <% end %>
    </div>
  </div>
  <%= form.button class: "cursor-pointer button button--primary" do %>
    Continue
  <% end %>
<% end %>
