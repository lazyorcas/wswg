<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body style="font-family: 'Inter', sans-serif, system-ui; padding: 20px; margin: 0; font-size: 16px; line-height: 1.5; text-align: center;">
    <h1 style="font-size: 2.25rem; font-weight: 700; color: #1c1917; margin-bottom: 1rem; line-height: 1.1;">
      Events in <%= @city.name %>
    </h1>
    <p style="font-size: 1.125rem; color: #57534e; margin-bottom: 1.5rem; line-height: 1.6;">
      <%= @week_start_date_str %> - <%= @week_end_date_str %>
    </p>
    <p style="font-size: 1.125rem; color: #1c1917; margin-bottom: 1.5rem; line-height: 1.6; max-width: 512px; margin-left: auto; margin-right: auto;">
      Browse and search for local events, meetups, and concerts from Luma, Meetup, Eventbrite, and Ticketmaster in one place.
    </p>
    <%= link_to @utm_url, target: "_blank", style: "display: inline-block; padding: 0 1rem; border-radius: 1.5rem; font-weight: 500; font-size: 1rem; white-space: nowrap; background-color: #ec4013; color: #fffdf0; text-decoration: none;" do %>
      <span style="text-align: center; display: block; margin-top: 0.625rem; margin-bottom: 0.625rem;">
        View <%= @events_count %>+ events
      </span>
    <% end %>
  </body>
</html>