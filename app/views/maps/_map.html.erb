<%= tag.div nil,
  style: "width: #{width}; height: #{height};",
  data: { 
    controller: "map",
    map_target: "container",
    map_access_token_value: ENV['MAPBOX_PUBLIC_ACCESS_TOKEN'],
    map_source_url_value: source_url,
    map_info_window_html_template_value: info_window_html_template,
    # Mapbox expects longitude first, latitude second
    map_center_coordinates_value: center_coordinates
  }
%>