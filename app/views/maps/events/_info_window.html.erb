<div>
  <div class="relative w-full h-auto">
    <img src="{image_url}" class="w-full h-full object-cover">
    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-4">
      <h3 class="text-white font-bold text-lg">{title}</h3>
    </div>
  </div>
  <div class="p-4">
    <div class="flex items-center space-x-2 text-gray-600 mb-3">
      <div class="bg-blue-50 rounded-lg p-2 text-center flex-shrink-0">
        <span class="block text-xs uppercase">{start_date}</span>
      </div>
      <div class="flex-1">
        <p class="text-sm">{start_time} - {end_time}</p>
        <p class="text-sm font-medium text-blue-600">{price}</p>
      </div>
    </div>
    <%= link_to "{url}", target: "_blank", rel: "noopener noreferrer", class: "block text-center bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-lg transition duration-150 ease-in-out text-sm font-medium" do %>
      View Event
    <% end %>
  </div>
</div>