<% content_for :title, "No credits left | Where Should We Go" %>
<div class="dark:bg-stone-800">
  <div class="h-dvh max-h-dvh flex flex-col container mx-auto px-4">
    <div class="my-auto flex flex-col items-center">
      <header class="flex flex-col md:gap-y-1 text-center">
        <h1 class="text-2xl md:text-3xl font-bold">No credits left.</h1>
        <%= link_to "View pricing", pricing_path, class: "text-sm text-secondary hover:underline" %>
      </header>
      <div class="py-4 md:py-8 w-fit">
        <%= link_to user_top_up_credits_path, class: "button button--primary" do %>
          <i class="ph-fill ph-coin"></i>
          Top up
        <% end %>
      </div>
    </div>
  </div>
</div>
