<% links = [
  ["Discover", searches_path, current_page?(searches_path) || current_page?(root_path), false], 
  ["Bookmarks", bookmarks_events_path, current_page?(bookmarks_events_path), false],
  ["Changelog", changelog_path, current_page?(changelog_path), true]
] %>
<%= tag.nav class: "shrink-0 flex", data: { controller: "home-nav" } do %>
  <% links.each do |link| %>
    <%= link_to link[0], link[1], 
      class: class_names("tab-button", link[2] ? "tab-button--active" : "tab-button--inactive"), 
      target: link[3] ? "_blank" : nil,
      data: link[3] ? nil : { 
        turbo_frame: "content",
        home_nav_target: "link"
      } %>
  <% end %>
<% end %>