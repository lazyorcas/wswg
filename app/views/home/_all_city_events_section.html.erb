<section class="flex-1 flex flex-col gap-y-2 md:gap-y-4 items-center">
  <h3 class="text-xl font-semibold">Events in <%= city.name %></h3>
  <ol class="flex flex-col">
    <% TimePeriod::SYMBOLS.each do |time_period_symbol| %>
      <li class="text-center">
        <%= link_to build_city_meta_title(city, :events, time_period_symbol), build_city_events_path(event_category_slug: "events", city_slug: city.slug, time_period_slug: TimePeriod.slugify(time_period_symbol)), class: "link" %>
      </li>
    <% end %>
    <li class="text-center">
      <%= link_to "#{city.name} events map", city_map_path(city_slug: city.slug), class: "link", data: { turbo: false } %>
    </li>
  </ol>
</section>