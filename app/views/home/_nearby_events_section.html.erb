<section class="flex-1 flex flex-col gap-y-2 md:gap-y-4 items-center">
  <h3 class="text-xl font-semibold">📍 Events near me</h3>
  <ol class="flex flex-col">
    <% EventCategory::SYMBOLS.each do |event_category_symbol| %>
      <% TimePeriod::SYMBOLS.each do |time_period_symbol| %>
        <li class="text-center">
          <%= link_to build_nearby_meta_title(event_category_symbol, time_period_symbol), build_nearby_events_path(event_category_slug: EventCategory::SYMBOL_TO_SLUG_MAPPING[event_category_symbol], time_period_slug: TimePeriod.slugify(time_period_symbol)), class: "link" %>
        </li>
      <% end %>
      </li>
    <% end %>
  </ol>
</section>