<section class="flex-1 flex flex-col gap-y-2 md:gap-y-4 items-center">
  <h3 class="text-xl font-semibold">📍 Events near me</h3>
  <ol class="flex flex-col">
    <% TimePeriod::SYMBOLS.each do |time_period_symbol| %>
      <li class="text-center">
        <%= link_to build_nearby_meta_title(time_period_symbol), build_nearby_events_path(time_period_slug: TimePeriod.slugify(time_period_symbol)), class: "link" %>
      </li>
    <% end %>
  </ol>
</section>