<%= tag.li class: class_names("event-item-skeleton shrink-0 size-full pointer-events-none", local_assigns[:class_name]) do %>
  <span class="size-full grid-item rounded-xl">
    <span class="size-full flex gap-x-4">
      <span class="grow flex flex-col list-item__text">
        <span class="w-full flex items-center gap-x-1 mb-3">
          <span class="inline-flex event-source-icon w-4 h-4 skeleton"></span>
          <span class="h-4 w-20 skeleton rounded-xl"></span>
        </span>
        <span class="h-5 w-3/4 skeleton rounded-2xl"></span>
        <span class="mt-3 flex flex-col gap-y-2">
          <span class="h-4 w-1/2 skeleton rounded-xl"></span>
          <span class="h-4 w-1/2 skeleton rounded-xl"></span>
          <span class="h-4 w-1/4 skeleton rounded-xl"></span>
        </span>
      </span>
      <span class="shrink-0 flex flex-col gap-y-4 h-full items-end justify-between">
        <span class="shrink-0 event-image skeleton"></span>
      </span>
    </span>
  </span>
<% end %>