<% content_for :title, @title %>
<% content_for :description, @description %>
<main class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center pt-20 pb-10">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold"><%= @title %></h1>
      <p class="md:max-w-xl"><%= @description %></p>
    </div>
  </header>
  <% unless signed_in? %>
    <section class="md:max-w-xl mx-auto">
      <%= render "form" %>
    </section>
  <% end %>
  <section class="-mx-4 md:max-w-3xl md:mx-auto flex flex-col py-10">
    <% if (today? || this_week?) && @events.any? %>
      <p class="px-4 text-sm text-secondary">Past events are not shown.</p>
    <% end %>
    <% if @events.any? %>
      <ol class="mt-4 mb-8 flex flex-col">
        <%= render @events %>
      </ol>
    <% else %>
      <p class="flash flash--warning mb-8 mx-auto">No events yet. Come back tomorrow.</p>
    <% end %>
    <p class="px-4 text-sm">
      <% if @events.any? %>
        <%= @events.count %>/<%= @all_events_count %> events are shown.
        <% if signed_in? %>
          <%= link_to "See all events", map_path, class: "link" %>.
        <% else %>
          <%= link_to "Create an account", new_user_path(city_id: @city.id), class: "link" %> to see all events.
        <% end %>
        <br />
      <% end %>
      <% if today? %>
        Additionally, you can view <%= link_to "events tomorrow in #{@city.name}", events_tomorrow_path(city_name: @city.name.parameterize), class: "link" %> or <%= link_to "events this week in #{@city.name}", events_this_week_path(city_name: @city.name.parameterize), class: "link" %>.
      <% elsif tomorrow? %>
        Additionally, you can view <%= link_to "events this week in #{@city.name}", events_this_week_path(city_name: @city.name.parameterize), class: "link" %>.
      <% elsif this_week? %>
        Additionally, you can view <%= link_to "events next week in #{@city.name}", events_next_week_path(city_name: @city.name.parameterize), class: "link" %>.
      <% elsif next_week? %>
        Additionally, you can view <%= link_to "events this week in #{@city.name}", events_this_week_path(city_name: @city.name.parameterize), class: "link" %>.
      <% end %>
    </p>
  </section>
</section>
</main>
