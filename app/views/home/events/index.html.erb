<% content_for :title, build_meta_title(@meta_title) %>
<% content_for :description, @description %>
<main class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center pt-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold md:max-w-3xl"><%= @title %></h1>
      <p class="md:max-w-2xl"><%= @description %></p>
    </div>
  </header>
  <section class="py-10 w-full flex flex-col">
    <% if @events.any? %>
      <div class="flex flex-wrap justify-between">
        <div class="ml-auto flex self-end">
          <% if @event_category.events? %>
            <%= render "current_person/settings/preferences/sort_by_popover_button" %>
          <% end %>
          <% if @map_path.present? %>
            <%= link_to @map_path, class: "icon-button icon-button--base button--ghost", data: { turbo: false }, aria: { label: "Events Map" } do %>
              <i class="ph ph-map-trifold"></i>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= tag.ol class: "mt-4 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-y-4 lg:gap-y-5 lg:gap-x-5", data: { 
        controller: class_names("seens", { "impressions": Current.person.persisted? }),
        impressions_impression_path_value: impression_path
      } do %>
        <% if sort_by_interests? %>
          <%= render partial: "event", collection: @events, cached: -> (event) { build_event_cache_key(event) } %>
          <%= turbo_frame_tag "new_event_batch_loader", loading: "lazy", src: @next_personalized_event_batch_path, class: "shrink-0 size-full" do %>
            <%= render partial: "home/events/event_item_skeleton" %>
          <% end %>
          <% (EventBatch::BATCH_SIZE - 1).times do %>
            <%= render partial: "home/events/event_item_skeleton" %>
          <% end %>
        <% elsif @event_batches.present? %>
          <% @event_batches.each_with_index do |event_batch, index| %>
            <% if index.zero? %>
              <%= render partial: "event", collection: event_batch, cached: -> (event) { build_event_cache_key(event) } %>
            <% else %>
              <%= render "home/event_batches/event_batch_loader", event_batch: event_batch, id: "event_batch_#{index}_loader" %>
            <% end %>
          <% end %>
        <% else %>
          <%= render partial: "event", collection: @events, cached: -> (event) { build_event_cache_key(event) } %>
        <% end %>
      <% end %>
      <div class="flex flex-col items-center">
        <%= link_to @search_query.present? ? map_path(search_query_id: @search_query.id) : city_map_path(city_slug: @city.slug), class: " mt-4 lg:mt-5 button button--primary", data: { turbo: false } do %>
          View all <%= @event_category.name %>
        <% end %>
      </div>
    <% else %>
      <p class="flash flash--warning mt-8 mx-auto">
        <%= @events_page_builder.no_events_message %>
      </p>
    <% end %>
    <p class="mt-8 mx-auto text-sm text-center md:max-w-4xl">
      Alternatively, you can view <%= @alternate_links_attributes.map { |link| link_to link[:title], link[:href], class: "link" }.to_sentence.html_safe %>.
    </p>
  </section>
  <%= render "home/sticky_search_bar", search_query: SearchQuery.new %>
</main>
