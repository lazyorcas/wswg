<% content_for :title, build_city_meta_title(@city, @time_period.to_sym) %>
<% content_for :description, build_city_description(@city, @time_period) %>
<main class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center pt-20 pb-10">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold"><%= build_city_title(@city, @time_period.to_sym) %></h1>
      <p class="md:max-w-xl"><%= build_city_description(@city, @time_period) %></p>
    </div>
  </header>
  <% unless signed_in? %>
    <section class="md:max-w-xl mx-auto">
      <%= render "form" %>
    </section>
  <% end %>
  <section class="py-10 w-full flex flex-col xl:flex-row gap-y-8 xl:gap-y-0 xl:gap-x-8">
    <section class="grow -mx-4 xl:mx-auto flex flex-col">
      <% if (@time_period.today? || @time_period.tonight? || @time_period.this_week? || @time_period.this_weekend?) && @events.any? %>
        <p class="px-4 text-sm text-secondary">Past events are not shown.</p>
      <% end %>
      <% if @events.any? %>
        <ol class="my-4 flex flex-col">
          <%= render @events %>
        </ol>
      <% else %>
        <p class="flash flash--warning mb-8 mx-auto">No events yet. Come back tomorrow.</p>
      <% end %>
      <p class="px-4 text-sm">
        <% if @events.any? %>
          <%= @events.size %>/<%= @all_events_count %> events are shown.
          <% if signed_in? %>
            <%= link_to "See all events", map_path, class: "link" %>.
          <% else %>
            <%= link_to "Create an account", new_user_path("user[city_id]" => @city.id), class: "link" %> to see all events.
          <% end %>
          <br />
        <% end %>
        Additionally, you can view <%= @alternate_link_attributes.map { |link| link_to link[:title], link[:href], class: "link" }.to_sentence.html_safe %>.
      </p>
    </section>
    <section class="shrink-0 h-fit xl:max-w-2xl relative xl:sticky xl:top-16">
      <img src="/hero-light.webp" alt="Where Should We Go's Hero Light" class="w-full rounded-xl block dark:hidden blur-[2px]" loading="lazy">
      <img src="/hero-dark.webp" alt="Where Should We Go's Hero Dark" class="w-full rounded-xl hidden dark:block blur-[2px]" loading="lazy">
      <%= link_to signed_in? ? map_path : new_user_path("user[city_id]" => @city.id), class: "button button--secondary absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" do %>
        <i class="ph ph-map-trifold"></i>
        Open map
      <% end %>
    </section>
  </section>
</section>
</main>
