<% content_for :title, build_city_meta_title(@city, @time_period.to_sym) %>
<% content_for :description, build_city_meta_description(@city, @time_period) %>
<% mobile_map_shown_at_index = 10 %>
<main class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center py-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold"><%= build_city_title(@city, @time_period.to_sym) %></h1>
      <p class="md:max-w-xl"><%= build_city_description(@city, @time_period).html_safe %></p>
    </div>
  </header>
  <% unless signed_in? %>
    <section class="md:max-w-xl mx-auto">
      <%= render "form" %>
    </section>
  <% end %>
  <section class="py-10 w-full flex flex-col xl:flex-row gap-y-8 xl:gap-y-0 xl:gap-x-8">
    <section class="grow -mx-4 xl:mx-auto flex flex-col">
      <p class="px-4 text-sm">
        <% if @events.any? %>
          <%= @events.size %>/<%= @all_events_count %> events are shown.
          <% if signed_in? %>
            <%= link_to "See all events", map_path, class: "link" %>.
          <% else %>
            <%= link_to "Create an account", new_user_path("user[city_id]" => @city.id, source: "New account button in city events page"), class: "link" %> to see all events.
          <% end %>
          <br />
        <% end %>
        Alternatively, you can view <%= @alternate_link_attributes.map { |link| link_to link[:title], link[:href], class: "link" }.to_sentence.html_safe %>.
      </p>
      <% if (@time_period.today? || @time_period.tonight?) && @events.any? %>
        <p class="mt-4 px-4 text-sm text-secondary italic">Past events are not shown.</p>
      <% end %>
      <% if @events.any? %>
        <ol class="my-4 flex flex-col">
          <%= render partial: "event", collection: @events.first(mobile_map_shown_at_index) %>
          <% if browser.device.mobile? %>
            <li class="shrink-0">
              <%= render "action_box" %>
            </li>
          <% end %>
          <%= render partial: "event", collection: @events[mobile_map_shown_at_index..] %>
          <% if @all_events_count > @events.size %>
            <li class="shrink-0 relative">
              <div class="blur-[2px]">
                <%= render "skeleton_event_item_link" %>
                <%= render "skeleton_event_item_link" %>
                <%= render "skeleton_event_item_link" %>
                <%= render "skeleton_event_item_link" %>
                <%= render "skeleton_event_item_link" %>
              </div>
              <%= link_to signed_in? ? map_path : new_user_path("user[city_id]" => @city.id, source: "See other events button in city events page"), class: "absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 button button--secondary" do %>
                <i class="ph ph-list-bullets"></i>
                See <%= @all_events_count - @events.size %> more events
              <% end %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="flash flash--warning mt-8 mx-auto">
          <% if @current_time.hour <= 6 %>
            Events are being fetched. Come back in 1-2 hours.
          <% elsif @time_period.all? %>
            No events found. Come back tomorrow.
          <% else %>
            No ongoing events found for <%= @time_period.to_s.downcase %>. Come back tomorrow.
          <% end %>
        </p>
      <% end %>
    </section>
    <% unless browser.device.mobile? %>
      <%= render "action_box" %>
    <% end %>
  </section>
</section>
</main>
