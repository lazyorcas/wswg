<% content_for :title, @meta_title %>
<% content_for :description, @description %>
<main class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center pt-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold"><%= @title %></h1>
      <p class="md:max-w-2xl"><%= @description %></p>
    </div>
    <% if field_test_variant(:search_bar_position) == "header" %>
      <%= render "home/header_search_bar", search_query: SearchQuery.new %>
    <% end %>
  </header>
  <section class="py-10 w-full flex flex-col">
    <% if @events.any? %>
      <div class="flex flex-wrap justify-between">
        <%= link_to personalization_path, class: "button button--ghost", rel: "nofollow" do %>
          <i class="ph ph-magic-wand"></i>
          Personalize
        <% end %>
        <div class="flex self-end">
          <% if Current.person.present? && @event_category.events? %>
            <%= render "current_person/settings/preferences/sort_by_popover_button" %>
          <% end %>
          <%= link_to map_path(@search_query.present? ? { search_query_id: @search_query.id } : { city_id: @city.id }), class: "icon-button icon-button--base button--ghost", rel: "nofollow", data: { turbo: false }, aria: { label: "Open map" } do %>
            <i class="ph ph-map-trifold"></i>
          <% end %>
          <% unless signed_in? %>
            <%= link_to new_user_path(source: "notification"), class: "icon-button icon-button--base button--ghost", aria: { label: "Subscribe to notifications" } do %>
              <i class="ph ph-bell-ringing"></i>
            <% end %>
          <% end %>
        </div>
      </div>
      <ol class="mt-4 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-y-4 lg:gap-y-5 lg:gap-x-5" data-controller="event-list">
        <%= render partial: "event", collection: @events, cached: -> (event) { build_event_cache_key(event) } %>
      </ol>
      <div class="flex flex-col items-center">
        <% if @all_events_count > @events.size %>
          <%= link_to map_path(@search_query.present? ? { search_query_id: @search_query.id } : { city_id: @city.id }), class: " mt-4 lg:mt-5 button button--primary", rel: "nofollow", data: { turbo: false } do %>
            View <%= @all_events_count - @events.size %> more <%= @event_category.to_s %>
          <% end %>
        <% end %>
        <p class="mt-8 text-sm text-center md:max-w-4xl">
          Alternatively, you can view <%= @alternate_link_attributes.map { |link| link_to link[:title], link[:href], class: "link" }.to_sentence.html_safe %>.
        </p>
      </div>
    <% else %>
      <p class="flash flash--warning mt-8 mx-auto">
        <% if @city.persisted? %>
          <% if @current_time.hour <= 8 %>
            <%= @event_category.to_s.humanize %> are being fetched. Come back in 1-2 hours.
          <% else %>
            No upcoming <%= @event_category.to_s %> found.
          <% end %>
        <% else %>
          Your city is not supported yet.
        <% end %>
      </p>
    <% end %>
  </section>
  <% if field_test_variant(:search_bar_position) == "sticky" %>
    <%= render "home/sticky_search_bar", search_query: SearchQuery.new %>
  <% end %>
</main>
