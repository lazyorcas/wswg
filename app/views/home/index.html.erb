      <div class="grow flex flex-col gap-y-4 md:gap-y-8 justify-center">
        <header class="flex flex-col md:gap-y-1">
          <h1 class="text-3xl md:text-5xl font-bold">Where Should We Go</h1>
          <p class="text-sm md:text-base">Find all local events in your city with one search.</p>
        </header>
        <div class="w-fit">
          <%= render "sessions/form" %>
        </div>
      </div>
      <div class="shrink-0">
        <%= render "shared/footer" %>
      </div>
    </div>
  </div>
</div>
