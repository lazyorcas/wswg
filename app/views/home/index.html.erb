<%= content_for :title, "Discover Local Events | Where Should We Go" %>
<div class="grow flex flex-col">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center pt-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold">Discover all local events with one search</h1>
      <p class="md:max-w-2xl">Browse and search for events, meetups, and concerts from Luma, Meetup, Eventbrite, and Ticketmaster in one place.</p>
    </div>
    <% if !signed_in? && field_test(:search_bar_position) == "header" %>
      <%= render "home/header_search_bar", search_query: SearchQuery.new %>
    <% else %>
      <%= link_to "View Events on Map", map_path, class: "button button--primary", rel: "nofollow", data: { turbo: false } %>
    <% end %>
  </header>
  <% if @events&.any? %>
    <section class="w-full flex flex-col gap-y-4 items-center pt-10 md:pt-20">
      <h2 class="self-center text-center text-2xl md:text-3xl font-semibold">Events near me</h2>
      <%= link_to map_path, class: "self-end button button--ghost", rel: "nofollow", data: { turbo: false } do %>
        <i class="ph ph-map-trifold"></i>
        Map View
      <% end %>
      <ol class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-y-4 lg:gap-y-5 lg:gap-x-5" data-controller="event-list">
        <%= render partial: "home/events/event", collection: @events, cached: -> (event) { build_event_cache_key(event) } %>
      </ol>
      <%= link_to all_city_events_path(event_category_slug: "events", city_slug: @city.slug), class: "w-fit button button--secondary" do %>
        View all events in <%= @city.name %>
      <% end %>
    </section>
  <% end %>
  <section class="w-full flex flex-col items-center gap-y-8 py-10 md:py-20" id="local-events-directory">
    <h2 class="text-center text-2xl md:text-3xl font-semibold">Local Events Directory</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 w-full">
      <% @enabled_cities.each do |city| %>
        <%= render "all_city_events_section", city: city %>
      <% end %>
    </div>
  </section>
  <% if signed_in? || field_test(:search_bar_position) == "sticky" %>
    <%= render "home/sticky_search_bar", search_query: SearchQuery.new %>
  <% end %>
</div>
