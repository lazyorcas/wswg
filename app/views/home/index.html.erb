<div class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center pt-20 pb-10">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold">Discover all local events with one search</h1>
      <p class="md:max-w-xl">Search for events, meetups, and concerts from Luma, Meetup, Eventbrite, and Ticketmaster using natural language. All in one place.</p>
    </div>
    <% unless signed_in? %>
      <%= link_to "Get Started", new_user_path, class: "w-full md:w-fit button button--primary" %>
    <% end %>
  </header>
  <section class="w-full">
    <img src="/hero-light.webp" alt="Where Should We Go Hero Light" class="w-full rounded-2xl block dark:hidden" loading="lazy">
    <img src="/hero-dark.webp" alt="Where Should We Go Hero Dark" class="w-full rounded-2xl hidden dark:block" loading="lazy">
  </section>
  <section class="w-full flex flex-col items-center gap-y-8 py-10 md:pt-20 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold">Local Events Directory</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
      <% @enabled_cities.each do |city| %>
        <%= render "city_events_section", city: city %>
      <% end %>
    </div>
  </section>
</div>
