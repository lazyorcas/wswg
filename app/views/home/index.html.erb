<div class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center py-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold">Discover all local events with one search</h1>
      <p class="md:max-w-xl">Search for events, meetups, and concerts from Luma, Meetup, Eventbrite, and Ticketmaster using natural language. All in one place.</p>
    </div>
    <div class="w-full md:max-w-xl mx-auto flex flex-col gap-y-2 items-center">
      <div class="w-full">
        <%= render "search_queries/form", search_query: SearchQuery.new %>
      </div>
      <span class="text-sm text-secondary">
        Or, <%= link_to "check out the local events directory", "#local-events-directory", class: "link" %>.
      </span>
    </div>
  </header>
  <%= link_to map_path, class: "w-full relative group cursor-pointer", rel: "nofollow", data: { turbo: false } do %>
    <img src="/hero-light.webp" alt="Where Should We Go's Hero Light" class="w-full rounded-2xl block dark:hidden group-hover:blur-xs transition-all" loading="lazy">
    <img src="/hero-dark.webp" alt="Where Should We Go's Hero Dark" class="w-full rounded-2xl hidden dark:block group-hover:blur-xs transition-all" loading="lazy">
    <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity">
      <span class="button button--primary">
        <i class="ph-fill ph-map-trifold"></i>
        Open map
      </span>
    </span>
  <% end %>
  <section class="w-full flex flex-col items-center gap-y-8 py-10 md:pt-20 text-center" id="local-events-directory">
    <h2 class="text-2xl md:text-3xl font-semibold">Local Events Directory</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 w-full">
      <% @enabled_cities.each do |city| %>
        <%= render "city_events_section", city: city %>
      <% end %>
    </div>
  </section>
</div>
