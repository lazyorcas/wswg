<%= form_with url: personalize_path, method: :put, class: "flex flex-col items-center gap-y-8" do |form| %>
  <h2 class="text-center text-xl md:text-2xl font-semibold">Why do you need personalization? (3/4)</h2>
  <div class="w-full flex flex-col md:flex-row gap-y-4 md:gap-y-0 md:gap-x-4">
    <%= form.text_field "personalization[reason]", class: "input input--accent", placeholder: "Enter your motivation", required: true %>
    <%= form.button class: "cursor-pointer button button--primary" do %>
      Continue
    <% end %>
  </div>
<% end %>