<div class="flex flex-col items-center gap-y-8">
  <h2 class="text-center text-xl md:text-2xl font-semibold">
    Where would you like to see personalized recommendations? (1/3)
  </h2>
  <div class="w-full flex flex-col md:flex-row gap-y-4 md:gap-y-0 md:gap-x-4">
    <%= button_to personalize_path, method: :put, params: { personalization: { medium: "newsletter" } }, class: "w-full button button--secondary", form_class: "flex-1" do %>
      <i class="ph-fill ph-newspaper"></i>
      Email Newsletter
    <% end %>
    <%= button_to personalize_path, method: :put, params: { personalization: { medium: "discovery_feed" } }, class: "w-full button button--secondary", form_class: "flex-1" do %>
      <i class="ph-fill ph-sparkle"></i>
      Discovery Feed
    <% end %>
  </div>
</div>