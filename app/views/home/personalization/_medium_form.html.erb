<div class="flex flex-col items-center gap-y-8">
  <h2 class="text-center text-xl md:text-2xl font-semibold">
    How would you like to see the personalized recommendations?
  </h2>
  <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4">
    <% Personalization::MEDIUMS.each do |medium| %>
      <%= button_to personalize_path, method: :put, params: { personalization: { medium: medium } }, class: "w-full button button--ghost", form_class: "flex-1" do %>
        <i class="ph <%= personalization_medium_icon(medium) %>"></i>
        <%= medium.humanize %>
      <% end %>
    <% end %>
  </div>
  <%= render "disabled_skip_button" %>
</div>