<%= form_with url: personalize_path, method: :put, class: "flex flex-col items-center gap-y-8" do |form| %>
  <h2 class="text-center text-xl md:text-2xl font-semibold">What's your Telegram handle?</h2>
  <div class="w-full flex flex-col md:flex-row gap-y-4 md:gap-y-0 md:gap-x-4">
    <%= form.text_field "personalization[telegram_username]", class: "input input--base", placeholder: "Enter your Telegram handle", required: true %>
    <%= form.button class: "cursor-pointer button button--primary" do %>
      Done
    <% end %>
  </div>
<% end %>