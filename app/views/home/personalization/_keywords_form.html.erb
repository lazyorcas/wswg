<div class="flex flex-col items-center gap-y-8">
  <h2 class="text-center text-xl md:text-2xl font-semibold">What are your interests? <i class="text-secondary">(Optional)</i></h2>
  <%= form_with url: personalize_path, method: :put, class: "w-full flex flex-col md:flex-row gap-y-4 md:gap-y-0 md:gap-x-4" do |form| %>
    <%= form.text_field "personalization[keywords]", class: "input input--base", placeholder: "Enter your interests", required: true %>
    <%= form.button class: "cursor-pointer button button--primary" do %>
      Continue
    <% end %>
  <% end %>
  <%= button_to personalize_path, method: :put, params: { personalization: { keywords: "" } }, class: "w-full button button--secondary" do %>
    <i class="ph ph-fast-forward"></i>
    Skip
  <% end %>
</div>