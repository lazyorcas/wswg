<% content_for :title, "Pricing | Where Should We Go" %>
<div class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center py-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold">Pricing</h1>
      <p class="md:max-w-2xl">Choose the right plan based on your need.</p>
    </div>
  </header>
  <div class="grid grid-cols-1 gap-4 md:gap-8 md:grid-cols-2 w-full md:max-w-3xl mx-auto">
    <%= render "pricing_plan",
      title: "Free",
      price: Money.from_amount(0).exchange_to(@city&.currency || "USD").format(no_cents: true),
      period: "/month",
      description: "Perfect for occasional searches",
      features: [
        [true, "No sign up needed."],
        [true, "Browse as much as you want."],
        [true, "View events on a map."],
        [true, "#{Credits::MONTHLY_FREE_CREDITS} free search days per month"],
        [false, "Extra search days"],
        [false, "Bookmark / Save for later"],
      ],
      cta: "Get Started",
      cta_path: signed_in? ? nil : new_user_path(source: "Pricing page")
    %>
    <%= render "pricing_plan",
      title: "Pay As You Search",
      price: Money.from_amount(5).exchange_to(@city&.currency || "USD").format,
      description: "Perfect for frequent searches",
      features: [
        [true, "Sign up with Google or without password"],
        [true, "Browse as much as you want."],
        [true, "View events on a map."],
        [true, "#{Credits::MONTHLY_FREE_CREDITS} free search days per month"],
        [true, "10 search days. No expiration."],
        [true, "Bookmark / Save for later"],
      ],
      cta: signed_in? ? "Top up" : "Get Started",
      cta_path: signed_in? ? current_user_top_up_credits_path : new_user_path(source: "Pricing page")
    %>
  </div>
  <section class="w-full md:max-w-3xl mx-auto py-20">
    <h2 class="text-2xl font-bold text-center mb-8">Frequently Asked Questions</h2>
    <div class="flex flex-col gap-y-4">
      <%= render "faq_item",
        question: "Must I use all 10 search days in a row?",
        answer: "No, not at all. You can use the search days as you need them."
      %>
      <%= render "faq_item",
        question: "When do I receive free search days?",
        answer: "Users with zero search days at the beginning of each month will automatically receive #{Credits::MONTHLY_FREE_CREDITS} free search days."
      %>
      <%= render "faq_item",
        question: "How do I get more search days?",
        answer: "You can purchase additional search days through our \"Pay As You Search\" plan."
      %>
    </div>
  </section>
</div>