<% content_for :title, "Pricing | Where Should We Go" %>
<div class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center py-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold">Pricing</h1>
      <p class="md:max-w-xl">Choose the right plan based on your need.</p>
    </div>
  </header>
  <div class="grid grid-cols-1 gap-4 md:gap-8 md:grid-cols-2 w-full md:max-w-3xl mx-auto">
    <%= render "pricing_plan",
      title: "Free",
      price: Money.from_amount(0).exchange_to(Current.person&.city&.currency || "USD").format(no_cents: true),
      period: "/month",
      description: "Perfect for occasional searches",
      features: [
        [true, "No sign up needed."],
        [true, "Map view"],
        [true, "#{Credits::MONTHLY_FREE_CREDITS} free day credits per month"],
        [false, "Bookmark / Save for later"],
      ],
      cta: "Get Started",
      cta_path: signed_in? ? nil : new_user_path(source: "Pricing page")
    %>
    <%= render "pricing_plan",
      title: "Pay As You Go",
      price: Money.from_amount(5).exchange_to(Current.person&.city&.currency || "USD").format,
      description: "Perfect for frequent searches",
      features: [
        [true, "10 day credits. No expiration."],
        [true, "Map view"],
        [true, "#{Credits::MONTHLY_FREE_CREDITS} free day credits per month"],
        [true, "Bookmark / Save for later"],
      ],
      cta: signed_in? ? "Top up" : "Get Started",
      cta_path: signed_in? ? current_user_top_up_credits_path : new_user_path(source: "Pricing page")
    %>
  </div>
  <section class="w-full md:max-w-3xl mx-auto py-20">
    <h2 class="text-2xl font-bold text-center mb-8">Frequently Asked Questions</h2>
    <div class="flex flex-col gap-y-4">
      <%= render "faq_item",
        question: "What is a day credit?",
        answer: "One day credit is consumed when you use our search engine within a 24-hour window. Only one day credit is counted within this period, regardless of how many searches you perform."
      %>
      <%= render "faq_item",
        question: "When do I receive free day credits?",
        answer: "Users with zero day credits at the beginning of each month will automatically receive #{Credits::MONTHLY_FREE_CREDITS} free day credits."
      %>
      <%= render "faq_item",
        question: "How do I get more day credits?",
        answer: "You can purchase additional day credits through our \"Pay As You Go\" plan."
      %>
    </div>
  </section>
</div>