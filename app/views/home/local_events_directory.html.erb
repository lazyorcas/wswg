<% content_for :title, build_meta_title("Events Directory") %>
<% content_for :description, "A directory of events, meetups, and concerts around the world for all time periods." %>
<main class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center py-10 md:py-20">
    <h1 class="text-3xl md:text-4xl font-bold">Local Events Directory</h1>
  </header>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 w-full pb-10">
    <%= render "nearby_events_section" %>
    <% @enabled_cities.each do |city| %>
      <%= render "city_events_section", city: city %>
    <% end %>
  </div>
</main>