<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Admin | Where Should We Go" %></title>
    <meta name="description" content="Where Should We Go is a search engine designed to make discovering local events faster and easier, using one simple search bar.">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="robots" content="noindex, nofollow" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= render "shared/head/favicon" %>
    <%= render "shared/head/fonts" %>
    <%= render "shared/head/icons" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "admin" %>
  </head>
  <body class="min-h-dvh">
    <%= yield %>
  </body>
</html>
