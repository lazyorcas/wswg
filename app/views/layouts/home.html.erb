<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Where Should We Go" %></title>
    <meta name="description" content="Where Should We Go is a search engine designed to make discovering local events faster and easier, using one simple search bar.">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= render "shared/head/favicon" %>
    <%= render "shared/head/fonts" %>
    <%= render "shared/head/icons" %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>
  <body class="min-h-dvh dark:bg-stone-800 container mx-auto flex flex-col px-4 py-4 md:py-8">
    <header class="flex items-center gap-x-2 justify-between">
      <%= link_to root_path do %>
        <%= image_tag "/logo.webp", class: "size-10 rounded", alt: "Where Should We Go Logo" %>
      <% end %>
      <nav class="flex items-center gap-x-4 md:gap-x-8">
        <%= link_to "Pricing", pricing_path %>
        <% if signed_in? %>
          <%= link_to map_path, class: "button button--primary", data: { turbo: false } do %>
            <i class="ph-fill ph-sparkle"></i>
            Discover
          <% end %>
        <% else %>
          <div class="flex items-center gap-x-2">
            <%= link_to "Login", login_path, class: "button button--secondary" %>
            <%= link_to "Sign up", new_user_path, class: "button button--primary" %>
          <% end %>
        </nav>
      </header>
      <div class="grow flex flex-col">
        <%= yield %>
      </div>
      <footer class="pt-4 md:pt-8 text-sm text-secondary flex justify-between">
        <div class="flex flex-col md:flex-row gap-y-1 md:gap-y-0 md:items-center md:gap-x-8">
          <span>&copy; Where Should We Go</span>
          <%= link_to "Terms of Service", "/terms", target: "_blank", class: "hover:underline" %>
          <%= link_to "Privacy Policy", "/privacy", target: "_blank", class: "hover:underline" %>
        </div>
        <%= link_to "Contact us", "https://www.linkedin.com/company/where-should-we-go/", target: "_blank", class: "ml-auto hover:underline" %>
      </footer>
      <%= render "shared/floating_flash" %>
    </body>
  </html>
