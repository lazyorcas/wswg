<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Where Should We Go" %></title>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Where Should We Go is a platform designed to make discovering interesting events, meetups, and concerts from multiple sources faster." %>">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= canonical_tag -%>
    <%= render "shared/head/visit" if Rails.env.production? %>
    <%= render "shared/head/favicon" %>
    <%= render "shared/head/fonts" %>
    <%= render "shared/head/icons" %>
    <%= render "shared/head/sentry" %>
    <%= render "shared/head/google_tag_manager" %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-dvh dark:bg-stone-900 container mx-auto flex flex-col px-4 md:px-0 py-4 md:py-8">
    <header class="flex items-center gap-x-2 justify-between">
      <%= link_to root_path, class: "shrink-0" do %>
        <%= image_tag "/logo.webp", class: "size-10 rounded", alt: "Where Should We Go Logo" %>
      <% end %>
      <div class="flex">
        <% if browser.device.mobile? %>
          <div>
            <button popovertarget="menu" class="icon-button icon-button--base button--ghost" title="Open Menu">
              <i class="ph ph-list"></i>
            </button>
            <div popover id="menu" class="modal p-4 w-xs max-w-full">
              <%= render "home/nav" %>
            </div>
          </div>
        <% else %>
          <%= render "home/nav" %>
        <% end %>
      </div>
    </header>
    <div class="grow flex flex-col">
      <%= yield %>
    </div>
    <footer class="pt-4 md:pt-8 text-sm text-secondary flex justify-between">
      <div class="flex flex-col md:flex-row gap-y-1 md:gap-y-0 md:items-center md:gap-x-8">
        <span>&copy; Where Should We Go, 2025</span>
        <%= link_to "Local Events Directory", local_events_directory_path, class: "hover:underline" %>
        <%= link_to "Events Near Me", all_nearby_events_path, class: "hover:underline" %>
        <%= link_to "Events Map", map_path, class: "hover:underline", data: { turbo: false } %>
      </div>
      <div class="flex flex-col md:flex-row gap-y-1 md:gap-y-0 items-end md:items-center md:gap-x-8">
        <%= link_to "Terms of Service", "/terms", target: "_blank", class: "hover:underline" %>
        <%= link_to "Privacy Policy", "/privacy", target: "_blank", class: "hover:underline" %>
        <%= link_to "Contact us", "https://www.linkedin.com/company/where-should-we-go/", target: "_blank", class: "ml-auto hover:underline" %>
      </div>
    </footer>
    <%= render "shared/floating_flash" %>
  </body>
</html>
