<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Where Should We Go" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.webp" type="image/webp">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.webp">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/head/fonts" %>
    <%= render "shared/head/icons" %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>
  <body class="min-h-dvh">
    <%= yield %>
    <% if signed_in? %>
      <%= turbo_stream_from [ Current.user, :flash ] %>
    <% end %>
    <aside class="fixed top-8 inset-x-8 md:top-[unset] md:inset-x-[unset] md:bottom-8 md:right-8" data-controller="flash">
      <%= turbo_frame_tag "flash", class: "flex flex-col gap-y-2 items-center md:items-end" do %>
        <%= render "shared/flash" %>
      <% end %>
    </aside>
  </body>
</html>
