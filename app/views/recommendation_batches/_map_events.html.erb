<%= turbo_frame_tag "new_event_batch_loader" do %>
  <%= turbo_stream.remove_all ".event-item-skeleton" %>
  <%= turbo_stream.replace "new_event_batch_loader" do %>
    <%= render partial: "map/events/event", collection: @events, cached: -> (event) { build_event_cache_key(event, is_map: true) } %>
    <% if @recommendation_batch_path.present? %>
      <%= turbo_frame_tag "new_event_batch_loader", loading: "lazy", src: @recommendation_batch_path, class: "shrink-0" do %>
        <%= render partial: "map/events/event_item_skeleton" %>
      <% end %>
      <% (EventBatch::BATCH_SIZE - 1).times do %>
        <%= render partial: "map/events/event_item_skeleton" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>