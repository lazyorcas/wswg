<%= tag.section class: "flex flex-col gap-y-2 h-full pt-4", data: { map_target: "source" } do %>
  <p class="shrink-0 text-secondary text-sm px-4">
    <% if events.any? %>
      Found <%= events.size %> events in <%= pluralize(took_in_seconds, "second") %>.
    <% else %>
      Nothing found. Try other keywords.
    <% end %>
  </p>
  <% if events.any? %>
    <div class="grow min-h-0">
      <%= render Event::Map::ListComponent.new(events, 
        bookmarked_event_ids: viewing_user.bookmarked_event_ids, 
        seen_event_ids: viewing_user.seen_event_ids) %>
    </div>
  <% end %>
<% end %>