<% content_for :head do %>
  <%= javascript_include_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.js" %>
  <%= stylesheet_link_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.css" %>
<% end %>
<main class="w-full h-dvh max-h-dvh flex">
  <% if @events.present?  %>
    <div class="absolute inset-0">
      <% if true %>
        <%= render "maps/map", 
            source_url: search_path(id: @search.public_id, format: :geojson),
            center_coordinates: [@center_location.longitude, @center_location.latitude],
            info_window_html_template: @info_window_html_template,
            width: "100%",
            height: "100%"
        %>
      <% else %>
        <div class="absolute inset-0 bg-neutral-200 dark:bg-neutral-800"></div>
      <% end %>
    </div>
  <% end %>
  <section class="absolute top-8 left-8 flex flex-col gap-y-4">
    <%= render "form", search: Event::Search.new(query: @search.query) %>
    <section class="overflow-y-scroll bg-white dark:bg-neutral-900 rounded-2xl" style="width: 512px;">
      <% if @events.present? %>
        <%= render "events", events: @events, search: @search %>
      <% end %>
      <%= render "shared/flash" %>
    </section>
  </section>
</main>