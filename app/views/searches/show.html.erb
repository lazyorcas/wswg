<% content_for :head do %>
  <%= javascript_include_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.js" %>
  <%= stylesheet_link_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.css" %>
<% end %>
<main class="w-full">
  <h1 class="text-3xl font-bold text-neutral-800 mb-2">Where Should We Go?</h1>
  <%= render "form", search: Event::Search.new(query: @search.query) %>
  <% if @events.present? %>
    <div class="mt-10">
      <%= render "maps/map", 
        source_url: search_path(id: @search.public_id, format: :geojson),
        center_coordinates: [@center_location.longitude, @center_location.latitude],
        info_window_html_template: @info_window_html_template
      %>
    </div>
    <div class="mt-10">
      <%= render "events", events: @events, search: @search %>
    </div>
  <% end %>
  <%= render "shared/flash" %>
</main>