<%= form_for search, url: searches_path, html: { class: "flex bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-300 dark:border-neutral-700" } do |form| %>
  <%= form.text_field :query,
    placeholder: "Search for things to do (e.g., 'concerts this weekend under $50')",
    class: "grow rounded-2xl px-4 h-11 text-neutral-700 dark:text-neutral-300",
    required: true
  %>
  <%= form.submit "Search", class: "shrink-0 bg-neutral-900 text-white rounded-2xl px-4 h-11 cursor-pointer" %>
<% end %>