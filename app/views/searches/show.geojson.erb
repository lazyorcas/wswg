{
  "type": "FeatureCollection",
  "features": [
    <% @located_events.map.with_index do |event, index| %>
    {
      "type": "Feature",
      "properties": {
        "image_url": "<%= event.image_url %>",
        "title": "<%= event.title %>",
        "start_date": "<%= event.start_date.to_date.strftime("%A, %B %d") %>",
        "start_time": "<%= event.start_time.to_time.strftime("%I:%M %p") %>",
        "end_time": "<%= event.end_time.to_time.strftime("%I:%M %p") %>",
        "price": "<%= event.price %>",
        "url": "<%= event.url %>"
      },
      "geometry": {
        "type": "Point",
        "coordinates": [ <%= event.location.longitude %>, <%= event.location.latitude %> ]
      }
    }<%= "," if index < @located_events.length - 1 %>
    <% end %>
  ]
}