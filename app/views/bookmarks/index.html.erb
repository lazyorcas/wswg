<% content_for :title, build_meta_title("Saved Events") %>
<% content_for :description, "View events, meetups, and concerts you have saved. Only upcoming events are shown." %>
<main class="grow">
  <header class="flex flex-col gap-y-8 md:gap-y-10 items-center pt-10 md:pt-20">
    <div class="flex flex-col items-center text-center gap-y-2 md:gap-y-4">
      <h1 class="text-3xl md:text-4xl font-bold">Saved Events</h1>
      <p class="md:max-w-2xl">View all upcoming events you have saved.</p>
    </div>
  </header>
  <section class="py-10 w-full flex flex-col items-center">
    <ol class="w-full grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-y-4 lg:gap-y-5 lg:gap-x-5" data-controller="event-list">
      <%= render partial: "home/events/event", collection: @events %>
    </ol>
    <%= link_to root_path, class: "mt-4 lg:mt-5 button button--primary" do %>
      Explore more events
    <% end %>
  </section>
</main>