<% content_for :head do %>
  <%= javascript_include_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.js" %>
  <%= stylesheet_link_tag "https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.css" %>
<% end %>
<%= tag.main class: "w-full h-dvh max-h-dvh flex", 
  data: { 
    controller: "map",
    map_access_token_value: ENV['MAPBOX_PUBLIC_ACCESS_TOKEN'],
    map_center_coordinates_value: [@center_location.longitude, @center_location.latitude],
    map_dark_mode_value: Time.current.in_time_zone(current_user.city.time_zone).hour > 18 || Time.current.in_time_zone(current_user.city.time_zone).hour < 6
  } do %>
  <% if @events.present?  %>
    <div class="absolute inset-0">
      <% if true %>
        <div class="size-full" data-map-target="container"></div>
      <% else %>
        <div class="absolute inset-0 bg-neutral-100 dark:bg-neutral-800"></div>
      <% end %>
    </div>
  <% end %>
  <section class="absolute py-8 left-8 flex gap-x-8 inset-y-0">
    <div class="text-7xl font-black italic text-neutral-300 logo dark:text-neutral-600">W</div>
    <div class="flex flex-col gap-y-2">
      <div class="flex">
        <button class="h-11 px-4 rounded-3xl flex items-center font-bold text-neutral-300 dark:text-neutral-600">Discover</button>
        <button class="h-11 px-4 rounded-3xl flex items-center font-bold dark:text-white">Bookmarks</button>
      </div>
      <section class="shadow overflow-y-scroll bg-white dark:bg-neutral-900 rounded-xl" style="max-width: 600px; min-width: 480px; width: 40vw;">
        <%= render "events", events: @events %>
      </section>
    </div>
  </section>
<% end %>