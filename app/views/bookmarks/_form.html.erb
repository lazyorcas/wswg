<%= form_for bookmark, html: { id: "#{dom_id(bookmark.event)}_bookmark_form" } do |form| %>
  <%= form.hidden_field :event_id, value: bookmark.event_id %>
  <%= form.hidden_field :removed, value: bookmark.persisted? && !bookmark.removed? %>
  <%= form.button class: "icon-button icon-button--base button--secondary" do %>
    <% if bookmark.persisted? && !bookmark.removed? %>
      <i class="ph-fill ph-bookmark-simple"></i>
    <% else %>
      <i class="ph ph-bookmark-simple"></i>
    <% end %>
  <% end %>
<% end %>