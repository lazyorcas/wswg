<%= turbo_frame_tag "content" do %>
  <%= tag.div class: "popup py-4 h-full", data: { map_target: "source" } do %>
    <% if @events.any? %>
      <%= render Bookmark::Event::Map::ListComponent.new(@events, city: Current.user.city) %>
    <% else %>
      <p class="px-4 text-sm text-primary">
        No events bookmarked yet.
      </p>
    <% end %>
  <% end %>
<% end %>