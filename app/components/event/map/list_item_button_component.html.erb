<%= tag.li class: "shrink-0" do %>
  <%= tag.button class: "w-full cursor-pointer list-item", data: data do %>
    <span class="pointer-events-none flex gap-x-4 items-start">
      <span class="grow flex flex-col list-item__text">
        <%= tag.span class: "mb-1 w-full flex items-center gap-x-1" do %>
          <%= image_tag source_icon_url, class: "inline-flex event-source-icon", loading: "lazy", alt: "#{@event.source.name} icon" %>
          <span class="text-sm"><%= @event.source.name %></span>
        <% end %>
        <%= tag.h2 @event.title, class: "text-base line-clamp-2 link", style: "word-break: break-word;" %>
        <span class="flex flex-col gap-y-1 mt-2">
          <%= tag.span class: "text-sm text-secondary flex gap-x-2", data: { nosnippet: "" } do %>
            <i class="ph ph-clock text-sm shrink-0 h-fit mt-[3px] size-3.5"></i>
            <%= date %> &#x2022; <%= time_range %>
          <% end %>
          <% if @event.location.present? %>
            <%= tag.span class: "text-sm text-secondary flex gap-x-2" do %>
              <i class="ph ph-map-pin text-sm shrink-0 h-fit mt-[3px] size-3.5"></i>
              <%= @event.location.full_address %>
            <% end %>
          <% end %>
          <span class="text-sm text-secondary flex gap-x-2">
            <i class="ph ph-info text-sm transition-transform shrink-0 mt-[3px] size-3.5"></i>
            <span class="underline underline-secondary">More details</span>
          </span>
        </span>
      </span>
      <%= image_tag @event.image_url, class: "shrink-0 event-image", loading: "lazy", referrerpolicy: "no-referrer", alt: "Event image" %>
    </span>
  <% end %>
<% end %>