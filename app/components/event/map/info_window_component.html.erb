<%= turbo_frame_tag dom_id(@event) do %>
  <%= tag.div class: class_names(helpers.browser.device.mobile? ? "h-full" : "popup"), data: { no_location: @event.location.nil?, bottom_sheet_target: helpers.browser.device.mobile? ? "content" : nil } do %>
    <div class="shrink-0 h-4"></div>
    <div class="h-full no-scrollbar flex flex-col gap-y-4 px-4 overflow-y-scroll md:overflow-y-auto" data-bottom-sheet-target="nonDraggable">
      <%= image_tag @event.image_url, class: "aspect-square object-contain rounded-lg w-full h-auto md:h-fit md:w-80 md:max-w-80", referrerpolicy: "no-referrer" %>
      <h1 class="text-base/5 md:text-lg/6 font-bold line-clamp-4 md:line-clamp-3" style="word-break: break-word;"><%= @event.title %></h1>
      <div class="flex flex-col gap-y-1">
        <div class="text-sm">
          <%= tag.p date %>
          <%= tag.p time_range %>
        </div>
        <div class="flex gap-1 flex-wrap">
          <% if @event.location.nil? %>
            <%= tag.p "No location found", class: "tag" %>
          <% end %>
          <% if @event.price.present? %>
            <%= tag.p price_label, class: "tag" %>
          <% end %>
        </div>
      </div>
      <div class="flex gap-x-2 pb-4 mt-auto">
        <%= link_to @event.url, class: "grow button button--secondary", target: "_blank", rel: "noopener noreferrer" do %>
          <i class="ph ph-arrow-square-out"></i>
          View details
        <% end %>
        <% if @bookmark.present? %>
          <%= render "bookmarks/form", bookmark: @bookmark %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>