<%= turbo_frame_tag dom_id(event) do %>
  <div class="flex flex-col gap-y-4 popup p-4">
    <div class="flex md:flex-col gap-x-4 md:gap-x-0 md:gap-y-4">
      <%= image_tag image_url, class: "aspect-square object-contain rounded-lg w-20 md:w-80 max-w-20 md:max-w-80 h-fit", referrerpolicy: "no-referrer" %>
      <h1 class="text-primary text-base/5 md:text-lg/6 font-bold line-clamp-4 md:line-clamp-3" style="word-break: break-word;"><%= title %></h1>
    </div>
    <div class="flex flex-col gap-y-1 text-primary">
      <div class="text-sm">
        <%= tag.p date %>
        <%= tag.p time_range %>
      </div>
      <div class="flex gap-1 flex-wrap">
        <% if location.nil? %>
          <%= tag.p "No location found", class: "tag" %>
        <% end %>
        <%= tag.p price_label, class: "tag" %>
      </div>
    </div>
    <div class="flex gap-x-2">
      <%= link_to url, class: "grow button button--secondary", target: "_blank", rel: "noopener noreferrer" do %>
        <i class="ph ph-arrow-square-out"></i>
        View details
      <% end %>
      <%= render "bookmarks/form", bookmark: bookmark %>
    </div>
  </div>
<% end %>