<%= turbo_frame_tag dom_id(event) do %>
  <div class="flex flex-col gap-y-4 popup p-4">
    <%= image_tag image_url, class: "aspect-square object-contain rounded-lg", style: "width: 320px; max-height: 320px;", referrerpolicy: "no-referrer" %>
    <div class="flex flex-col gap-y-1 text-primary">
      <h1 class="text-lg/6 font-bold line-clamp-3" style="word-break: break-word;"><%= title %></h1>
      <div class="text-sm">
        <%= tag.p date %>
        <%= tag.p time_range %>
      </div>
      <div class="flex gap-1 flex-wrap">
        <% if location.nil? %>
          <%= tag.p "No location found", class: "tag" %>
        <% end %>
        <%= tag.p price_label, class: "tag" %>
      </div>
    </div>
    <div class="flex gap-x-2">
      <%= link_to url, class: "grow button button--secondary", target: "_blank", rel: "noopener noreferrer" do %>
        <i class="ph ph-arrow-square-out"></i>
        View details
      <% end %>
      <%= render "bookmarks/form", bookmark: bookmark %>
    </div>
  </div>
<% end %>