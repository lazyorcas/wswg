<tr>
  <%= tag.td do %>
    <span class="flex items-center gap-x-2 justify-between">
      <%= link_to @event.url, class: "line-clamp-2 hover:underline", target: "_blank" do %>
        <%= @event.title %>
      <% end %>
      <%= link_to business_events_path(event_id: @event.id), class: "shrink-0 icon-button icon-button--small button--ghost", title: "View similar events" do %>
        <%= tag.i class: "ph ph-intersect" %>
      <% end %>
    </span>
  <% end %>
  <%= tag.td do %>
    <% if organizer.present? %>
      <span class="flex items-center gap-x-2 justify-between">
        <%= link_to organizer_url, class: "grow line-clamp-2 hover:underline", target: "_blank" do %>
          <%= organizer %>
        <% end %>
        <%= link_to business_events_path(organizer_id: @event.organizer_id), class: "shrink-0 icon-button icon-button--small button--ghost", title: "View events by this organizer" do %>
          <%= tag.i class: "ph ph-user-focus" %>
        <% end %>
      </span>
    <% end %>
  <% end %>
  <%= tag.td do %>
    <% if venue.present? %>
      <span class="flex items-center gap-x-2 justify-between">
        <%= link_to "https://www.google.com/maps/search/?api=1&query=#{CGI.escape(venue)}", class: "grow line-clamp-2 hover:underline", target: "_blank" do %>
          <%= venue %>
        <% end %>
        <%= link_to business_events_path(location_id: @event.location_id), class: "shrink-0 icon-button icon-button--small button--ghost", title: "View events at this venue" do %>
          <%= tag.i class: "ph ph-cube-focus" %>
        <% end %>
      </span>
    <% end %>
  <% end %>
  <%= tag.td do %>
    <span class="line-clamp-2"><%= date %></span>
  <% end %>
  <%= tag.td do %>
    <span class="line-clamp-2"><%= time_range %></span>
  <% end %>
  <%= tag.td do %>
    <span class="flex items-center gap-x-2 flex-wrap">
      <%= image_tag source_icon_url, class: "size-4 rounded" %>
      <%= @event.source.name %>
    </span>
  <% end %>
</tr>