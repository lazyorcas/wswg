<tr>
  <%= tag.td do %>
    <span class="flex items-center justify-between">
      <%= image_tag @event.image_url, class: "shrink-0 size-16 rounded-sm object-cover" %>
      <%= link_to @event.title, @event.url, class: "pl-4 pr-2 grow text-left line-clamp-2 hover:underline", target: "_blank" %>
      <%= link_to business_events_path(event_id: @event.id), class: "shrink-0 icon-button icon-button--small button--ghost", title: "View similar events", target: "_blank" do %>
        <%= tag.i class: "ph ph-intersect" %>
      <% end %>
    </span>
  <% end %>
  <%= tag.td do %>
    <% if organizer.present? %>
      <span class="flex items-center gap-x-2 justify-between">
        <%= link_to organizer_url, class: "grow line-clamp-2 hover:underline", target: "_blank" do %>
          <%= organizer %>
        <% end %>
        <%= link_to business_events_path(organizer_id: @event.organizer_id), class: "shrink-0 icon-button icon-button--small button--ghost", title: "View events by this organizer", target: "_blank" do %>
          <%= tag.i class: "ph ph-user-focus" %>
        <% end %>
        <%= turbo_frame_tag "#{dom_id(@event.organizer)}_bookmark", src: business_organizer_bookmark_path(@event.organizer), loading: "lazy" do %>
          <span class="icon-button icon-button--small button--disabled">
            <%= tag.i class: "ph ph-bookmark-simple" %>
          </span>
        <% end %>
      </span>
    <% end %>
  <% end %>
  <%= tag.td do %>
    <% if venue.present? %>
      <span class="flex items-center gap-x-2 justify-between">
        <%= link_to "https://www.google.com/maps/search/?api=1&query=#{CGI.escape(venue)}", class: "grow line-clamp-2 hover:underline", target: "_blank" do %>
          <%= venue %>
        <% end %>
      </span>
    <% end %>
  <% end %>
  <%= tag.td do %>
    <span class="line-clamp-2"><%= date %></span>
  <% end %>
  <%= tag.td do %>
    <span class="line-clamp-2"><%= time_range %></span>
  <% end %>
  <%= tag.td do %>
    <span class="line-clamp-2"><%= @event.attendees_count %></span>
    <% if @event.attendees_count.present? %>
      <span class="text-xs italic text-secondary">
        (As of: <%= last_updated_at %>)
      </span>
    <% end %>
  <% end %>
  <%= tag.td do %>
    <span class="flex items-center gap-x-2 flex-wrap">
      <%= image_tag source_icon_url, class: "size-4 rounded" %>
      <%= @event.source.name %>
    </span>
  <% end %>
</tr>