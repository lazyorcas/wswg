<%= turbo_frame_tag dom_id(event) do %>
  <div class="flex gap-x-4 bg-white dark:bg-neutral-900 rounded-xl pl-2 pr-4 py-2 border border-neutral-300 dark:border-neutral-800">
    <%= image_tag event.image_url, class: "aspect-square object-cover rounded-lg", style: "width: 128px;" %>
    <div class="grow flex flex-col justify-between gap-y-2">
      <div>
        <h1 class="text-lg font-bold line-clamp-2"><%= event.title %></h1>
        <%= tag.p "#{date} at #{time_range}", class: "text-sm" %>
      </div>
      <%= link_to event.url, target: "_blank", rel: "noopener noreferrer", class: "flex justify-center items-center bg-neutral-200 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-100 py-2 px-4 rounded-lg transition duration-150 ease-in-out text-sm font-medium" do %>
        View Event
      <% end %>
    </div>
  <% end %>