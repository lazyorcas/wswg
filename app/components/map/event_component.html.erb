<%= tag.div class: "bg-white dark:bg-neutral-900 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition ease-in-out rounded-xl group py-2 px-4 group cursor-pointer flex gap-x-4 justify-between", data: data do %>
  <%= tag.a target: "_blank", class: "grow" do %>
    <div class="flex gap-x-4">
      <%= image_tag source_icon_url, class: "shrink-0 w-4 h-4 mt-0.5 grayscale group-hover:grayscale-0 transition-all" %>
      <div class="grow flex flex-col">
        <%= tag.h2 title, 
            class: "text-sm group-hover:font-semibold text-neutral-800 dark:text-neutral-100 line-clamp-1" %>
        <% if location.blank? %>
          <div class="flex gap-x-2 justify-between">
            <%= tag.p "#{date} at #{time_range}",
              class: "text-xs text-neutral-400 dark:text-neutral-500" %>
            <%= tag.p "Can't find location",
                class: "text-xs italic text-neutral-400 dark:text-neutral-500" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <button class="shrink-0 group-hover:block hidden cursor-pointer">
    <%= heroicon "bookmark", size: 16, title: "Bookmark" %>
  </button>
<% end %>