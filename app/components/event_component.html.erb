<li class="bg-white rounded-xl border border-neutral-200 hover:border-neutral-900 transition ease-in-out">
  <%= tag.a href: event.url, class: "size-full", target: "_blank" do %>
    <div class="size-full p-4 flex flex-col gap-y-2 justify-between">
      <div class="flex justify-between gap-x-2">
        <h2 class="text-sm font-semibold text-neutral-800 line-clamp-2">
          <%= event.title %>
        </h2>
        <span class="h-fit bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded-2xl">
          <%= price_label %>
        </span>
      </div>
      <p class="text-xs text-neutral-500">
        <%= "#{event.start_date.to_date.strftime('%A, %B %d')} at #{event.start_time.to_time.strftime('%I:%M %p')}" %>
      </p>
    </div>
  <% end %>
</li>