<%= tag.li class: "bg-white dark:bg-neutral-900 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition ease-in-out rounded group py-2 px-4", data: { event_id: event.id } do %>
  <%= tag.a href: url, class: "size-full", target: "_blank", data: { event_url: url } do %>
    <div class="size-full flex gap-x-2">
      <%= image_tag image_url, class: "w-12 h-12 object-cover rounded grayscale group-hover:grayscale-0 transition ease-in-out", data: { event_image_url: image_url } %>
      <div class="grow flex flex-col gap-y-2 justify-between">
        <div class="flex justify-between gap-x-2">
          <%= tag.h2 title, 
            class: "text-sm font-semibold text-neutral-800 dark:text-neutral-100 line-clamp-2", 
            data: { event_title: title } %>
          <%= tag.span price_label,
            class: "h-fit bg-neutral-200 text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200 text-xs px-2 py-1 rounded-2xl", 
            data: { event_price_label: price_label } %>
        </div>
        <%= tag.p "#{date} at #{time}",
          class: "text-xs text-neutral-500 dark:text-neutral-400",
          data: { event_date: date, event_time: time } %>
      </div>
    </div>
  <% end %>
<% end %>