<%= tag.li class: "shrink-0" do %>
  <span class="w-full list-item rounded-xl">
    <span class="flex gap-x-4">
      <%= link_to event_redirect_path(@event), class: "grow flex gap-x-4", target: "_blank", rel: "nofollow" do %>
        <% if helpers.browser.bot? %>
          <div class="shrink-0 event-image bg-stone-200 dark:bg-stone-700" alt="Event image"></div>
        <% else %>
          <%= image_tag @event.image_url, class: "shrink-0 event-image", loading: "lazy", referrerpolicy: "no-referrer", alt: "Event image" %>
        <% end %>
        <span class="grow flex flex-col list-item__text">
          <%= tag.span class: class_names("w-full flex items-center gap-x-1", @event.seen_count.positive? ? "mb-1" : "mb-2") do %>
            <%= image_tag source_icon_url, class: "inline-flex event-source-icon", loading: "lazy", alt: "Event source icon" %>
            <span class="text-xs"><%= @event.source.name %></span>
            <% if @event.seen_count.positive? %>
              <span class="ml-auto md:ml-2 tag tag--hot font-semibold flex items-center gap-x-1">
                <i class="ph-fill ph-fire"></i>
                Popular
              </span>
            <% end %>
          <% end %>
          <%= tag.h2 @event.title, class: "text-sm line-clamp-2 md:line-clamp-1" %>
          <%= tag.p class: "text-xs text-secondary" do %>
            <%= date %> &#x2022; <%= time_range %>
          <% end %>
        </span>
      <% end %>
      <% if !helpers.signed_in? && !helpers.browser.device.mobile? %>
        <%= form_with url: new_user_path, method: :get, class: "shrink-0" do |form| %>
          <%= form.hidden_field "source", value: "Bookmark button in event listing" %>
          <%= form.hidden_field "user[city_id]", value: @event.city.id %>
          <%= form.hidden_field "user[bookmarks_attributes][0][event_id]", value: @event.id %>
          <%= form.button type: :submit, class: "icon-button icon-button--base button--secondary", title: "Save for later" do %>
            <i class="ph ph-bookmark-simple"></i>
          <% end %>
        <% end %>
      <% end %>
    </span>
  </span>
<% end %>